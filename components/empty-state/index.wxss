@import "../../styles/tokens.wxss";

.empty {
  text-align: center;
  padding: 70rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon-well {
  width: 136rpx;
  height: 136rpx;
  border-radius: var(--tm-radius-well, 34rpx);
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.empty-img {
  width: 84rpx;
  height: 84rpx;
  display: block;
  opacity: 0.8;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tm-text-secondary);
  margin-bottom: 8rpx;
  letter-spacing: 0.02em;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  max-width: 480rpx;
  line-height: 1.4;
}
