@import "../../styles/tokens.wxss";

.t-card {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  background-color: var(--tm-bg-card);
  border-radius: var(--tm-radius-md);
  margin-bottom: 20rpx;
  box-shadow: var(--tm-shadow-card);
  border: 1rpx solid var(--tm-border-light);
  position: relative;
  transition: transform 0.18s var(--tm-spring-ease), box-shadow 0.18s var(--tm-spring-ease), border-color 0.18s ease;
  overflow: hidden;
}

.t-card:active {
  transform: scale(0.978);
  box-shadow: var(--tm-shadow-sm);
  opacity: 0.94;
}

.t-card-home {
  padding: 22rpx 24rpx;
  border-radius: var(--tm-radius-sm);
}

/* 左侧彩色和纸书签竖条 */
.t-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 52rpx;
  transform: translateY(-50%);
  border-radius: 0 6rpx 6rpx 0;
  opacity: 0.85;
  background: var(--tm-coffee);
}

.t-card-orange::before { background: var(--tm-accent); }
.t-card-green::before  { background: var(--tm-primary); }
.t-card-pink::before   { background: var(--tm-pink); }
.t-card-blue::before   { background: var(--tm-blue); }
.t-card-coffee::before { background: var(--tm-coffee); }
.t-card-yellow::before { background: var(--tm-yellow); }
.t-card-purple::before { background: var(--tm-purple); }
.t-card-gray::before   { background: var(--tm-gray); }

/* 缩略图容器 */
.t-thumb {
  margin-right: 22rpx;
  flex-shrink: 0;
  width: 78rpx;
  height: 78rpx;
  border-radius: 22rpx;
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.4);
}

.t-thumb-img {
  width: 48rpx;
  height: 48rpx;
}

.t-body {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.t-head-row {
  display: flex;
  align-items: center;
}

.t-title {
  font-size: 30rpx;
  color: var(--tm-text-primary);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 0.01em;
}

.t-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--tm-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.t-date {
  color: var(--tm-text-muted);
}

.t-items {
  color: var(--tm-text-secondary);
}

.t-side {
  margin-left: 12rpx;
  text-align: right;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.t-amount {
  font-size: 32rpx;
  color: var(--tm-accent-deep);
  font-weight: 700;
  white-space: nowrap;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.t-category {
  margin-top: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
