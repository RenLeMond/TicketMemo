.t-card {
  display: flex;
  align-items: center;
  padding: 24rpx 22rpx;
  background-color: #FFFCF7;
  border-radius: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(184, 153, 104, 0.06);
  border: 1rpx solid rgba(232, 223, 201, 0.5);
  position: relative;
}

.t-card-home {
  padding: 22rpx 22rpx;
  border-radius: 18rpx;
}

.t-card::before {
  content: "";
  position: absolute;
  left: 0; top: 50%;
  width: 6rpx; height: 50rpx;
  transform: translateY(-50%);
  background: linear-gradient(180deg, #A8C5A0 0%, #E8A87C 100%);
  border-radius: 0 6rpx 6rpx 0;
  opacity: 0.6;
}

.t-thumb {
  margin-right: 22rpx;
}

.t-card-home .t-thumb {
  width: 70rpx;
  height: 70rpx;
  border-radius: 16rpx;
}

.t-card-home .t-thumb-img {
  width: 42rpx;
  height: 42rpx;
}

.t-body { flex: 1; min-width: 0; }

.t-title {
  font-size: 30rpx;
  color: #5C4A3A;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.t-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A89C8A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.t-amount {
  font-size: 32rpx;
  color: #C97B47;
  font-weight: 600;
  white-space: nowrap;
}

.t-side {
  margin-left: 16rpx;
  text-align: right;
}

.t-category {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 18rpx;
  background: #f5efe4;
  color: #8b7355;
  font-size: 21rpx;
}

.t-thumb-img {
  width: 48rpx;
  height: 48rpx;
}
