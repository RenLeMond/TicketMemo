<view class="t-card {{variant === 'home' ? 't-card-home' : ''}}" bindtap="onTap">
  <view class="t-thumb icon-circle icon-circle-{{receipt.color || 'coffee'}}">
    <image class="t-thumb-img" src="{{thumbSrc}}" mode="aspectFit" />
  </view>
  <view class="t-body">
    <view class="t-title">{{receipt.merchant}}</view>
    <view class="t-meta">
      <text wx:if="{{showDate}}" class="t-date">{{_dateText}}</text>
      <text wx:if="{{receipt.items}}" class="t-items"> · {{receipt.items}}</text>
    </view>
  </view>
  <view class="t-side">
    <view class="t-amount">{{_amountText}}</view>
    <view wx:if="{{variant === 'home'}}" class="t-category">{{receipt.categoryName}}</view>
  </view>
</view>
