@import "./styles/tokens.wxss";

/* ============== Awwwards-Tier 全局手账森系设计系统 ============== */

page {
  background-color: var(--tm-bg-page);
  background-image:
    radial-gradient(circle at 12% 8%, rgba(232, 168, 124, 0.06) 0, transparent 38%),
    radial-gradient(circle at 88% 88%, rgba(143, 174, 133, 0.06) 0, transparent 38%);
  font-family: var(--tm-font-body);
  color: var(--tm-text-primary);
  font-size: 28rpx;
  line-height: 1.55;
  min-height: 100vh;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
}

view, text, button, input, textarea, scroll-view, image {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

/* 展示性手账标题字体 */
.font-display {
  font-family: var(--tm-font-display);
  letter-spacing: 0.04em;
  font-weight: 700;
}

/* 专用数字排版：Tabular Figures 对齐 */
.font-number {
  font-family: var(--tm-font-number);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
  font-feature-settings: "tnum";
}

/* ============== 微型 Eyebrow 标签（极简奢华） ============== */

.eyebrow-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--tm-radius-pill);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  background: var(--tm-primary-tray);
  color: var(--tm-primary-deep);
  border: 1rpx solid rgba(143, 174, 133, 0.28);
  margin-bottom: 12rpx;
}

.eyebrow-tag-accent {
  background: var(--tm-accent-tray);
  color: var(--tm-accent-deep);
  border-color: rgba(232, 168, 124, 0.28);
}

/* ============== 双层边框硬件拟物架构 (Double-Bezel / Doppelrand) ============== */

.bezel-tray {
  background-color: var(--tm-bg-tray);
  border: 1rpx solid var(--tm-border-light);
  border-radius: var(--tm-radius-tray);
  padding: 8rpx;
  box-shadow: var(--tm-shadow-card);
  position: relative;
  overflow: visible;
  transition: transform 0.22s var(--tm-spring-ease), box-shadow 0.22s var(--tm-spring-ease);
}

.bezel-core {
  background-color: var(--tm-bg-card);
  border-radius: var(--tm-radius-core);
  padding: 28rpx;
  border: 1rpx solid var(--tm-border-highlight);
  box-shadow: var(--tm-inset-highlight);
  position: relative;
  overflow: hidden;
}

/* 账本托盘：包住小票行，语言与快捷分类框一致 */
.ledger-tray {
  margin-bottom: 24rpx;
}

.ledger-core {
  padding: 8rpx 10rpx 10rpx;
}

.ledger-core .empty {
  padding: 48rpx 24rpx 40rpx;
}

/* 基础单层卡片（带同心内发光） */
.card {
  background-color: var(--tm-bg-card);
  border-radius: var(--tm-radius-md);
  padding: 28rpx;
  box-shadow: var(--tm-shadow-card);
  border: 1rpx solid var(--tm-border-light);
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

/* ============== 和纸胶带拟物装饰 (Washi Tape) ============== */

.tape {
  position: absolute;
  width: 96rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--tm-tape-bg);
  border: 1rpx solid var(--tm-tape-border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  z-index: 5;
  pointer-events: none;
}

.tape-left {
  left: 24rpx;
  top: -12rpx;
  transform: rotate(-3.5deg);
}

.tape-right {
  right: 24rpx;
  top: -12rpx;
  transform: rotate(3deg);
}

.tape-center {
  left: 50%;
  top: -14rpx;
  transform: translateX(-50%) rotate(-1deg);
}

.tape-green {
  background: var(--tm-tape-green);
  border-color: rgba(143, 174, 133, 0.35);
}

.tape-pink {
  background: var(--tm-tape-pink);
  border-color: rgba(232, 168, 171, 0.35);
}

.tape-blue {
  background: var(--tm-tape-blue);
  border-color: rgba(160, 184, 204, 0.35);
}

/* ============== 触觉按压交互反馈 (Spring Physics & Touch Shape Alignment) ============== */

.btn:active, .card-tap:active, .icon-cell:active, .tag-pick:active, 
.nav-back-btn:active, .cat-chip:active, .pick-card:active, .action-cell:active,
.btn-nested:active, .cat-add-btn:active, .event-add-btn:active,
.act-icon-disc:active, .top-medal-well:active, .quick-cat:active, .safe-card:active {
  transform: scale(0.965);
  opacity: 0.92;
  transition: transform 0.16s var(--tm-spring-bounce), opacity 0.16s ease;
}

/* ============== 嵌套岛按钮体系 (Button-in-Button Architecture) ============== */

.btn-nested {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 16rpx 0 32rpx;
  border-radius: var(--tm-radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
  cursor: pointer;
  box-shadow: var(--tm-shadow-sm);
  overflow: hidden;
  transition: all 0.22s var(--tm-spring-ease);
}

.btn-nested-primary {
  background: linear-gradient(135deg, var(--tm-primary) 0%, var(--tm-primary-deep) 100%);
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: var(--tm-shadow-glow);
}

.btn-nested-accent {
  background: linear-gradient(135deg, var(--tm-accent) 0%, var(--tm-accent-deep) 100%);
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.2);
  box-shadow: 0 8rpx 24rpx rgba(232, 168, 124, 0.35);
}

.btn-nested-tray {
  width: 60rpx;
  height: 60rpx;
  border-radius: var(--tm-radius-well, 18rpx);
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: inset 0 2rpx 5rpx rgba(0, 0, 0, 0.18), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.45);
  transition: transform 0.2s var(--tm-spring-bounce);
  overflow: hidden;
  box-sizing: border-box;
}

.btn-nested:active .btn-nested-tray {
  transform: scale(1.08) translate(1rpx, -1rpx);
}

.btn-nested-ico {
  width: 34rpx;
  height: 34rpx;
}

/* 常规按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  padding: 0 36rpx;
  border-radius: var(--tm-radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  border: none;
  cursor: pointer;
  overflow: hidden;
}

.btn-primary {
  background: linear-gradient(135deg, var(--tm-primary) 0%, var(--tm-primary-deep) 100%);
  color: #FFFFFF;
  box-shadow: var(--tm-shadow-glow);
}

.btn-danger {
  background: linear-gradient(135deg, #B86F65 0%, #9E564C 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(184, 111, 101, 0.35);
}

.btn-ghost {
  background-color: var(--tm-bg-card);
  color: var(--tm-primary-deep);
  border: 1rpx solid var(--tm-border);
  box-shadow: var(--tm-shadow-sm);
}

.btn-block {
  display: flex;
  width: 100%;
  height: 96rpx;
  border-radius: var(--tm-radius-md);
  font-size: 30rpx;
}

button::after { border: none !important; }

/* ============== 弹窗与底部固定栏通用间距体系 ============== */

.sheet-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  margin-top: 32rpx;
  box-sizing: border-box;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(24rpx + env(safe-area-inset-bottom, 24px));
  background: var(--tm-tab-bg);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border-top: 1rpx solid var(--tm-tab-border);
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
  box-sizing: border-box;
}

/* ============== 通用页面容器 ============== */

.page-container {
  padding-top: calc(env(safe-area-inset-top, 44px) + 90rpx);
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-bottom: calc(230rpx + env(safe-area-inset-bottom, 24px));
  min-height: 100vh;
}

/* 顶部导航返回 (纯 CSS 精准居中 Chevron 箭头) */
.nav-back-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.nav-back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--tm-bg-card);
  border: 1rpx solid var(--tm-border);
  box-shadow: var(--tm-shadow-sm);
  cursor: pointer;
  overflow: hidden;
  flex-shrink: 0;
  padding: 0;
  margin: 0;
}

.nav-back-btn::after {
  content: "";
  display: block;
  width: 16rpx;
  height: 16rpx;
  border-left: 4rpx solid var(--tm-text-primary);
  border-bottom: 4rpx solid var(--tm-text-primary);
  transform: rotate(45deg);
  margin-left: 6rpx; /* 视觉居中光学微调 */
}

.nav-page-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  margin-left: 20rpx;
}

/* 章节标题 */
.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  margin: 36rpx 0 20rpx 4rpx;
  letter-spacing: 0.02em;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--tm-primary) 0%, var(--tm-accent) 100%);
  border-radius: 6rpx;
  margin-right: 14rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-left: auto;
  font-weight: normal;
  display: inline-flex;
  align-items: center;
  line-height: 1;
  cursor: pointer;
}

.section-subtitle-arrow {
  font-size: 28rpx;
  margin-left: 6rpx;
  color: var(--tm-text-light);
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-1rpx);
}

/* ============== 标签体系 (Tags) ============== */

.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: var(--tm-radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  background-color: var(--tm-bg-tag-default);
  color: var(--tm-text-secondary);
  border: 1rpx solid transparent;
  box-sizing: border-box;
  overflow: hidden;
  text-align: center;
  flex-shrink: 0;
}

.tag-green   { background-color: var(--tm-primary-light); color: var(--tm-primary-deep); }
.tag-orange  { background-color: var(--tm-accent-light);  color: var(--tm-accent-deep); }
.tag-coffee  { background-color: var(--tm-coffee-light);  color: var(--tm-coffee); }
.tag-pink    { background-color: var(--tm-pink-light);    color: #B86F65; }
.tag-blue    { background-color: var(--tm-blue-light);    color: #4F7290; }
.tag-yellow  { background-color: var(--tm-yellow-light);  color: #A08030; }
.tag-purple  { background-color: var(--tm-purple-light);  color: #7A6090; }
.tag-gray    { background-color: var(--tm-gray-light);    color: var(--tm-text-muted); }

/* 深色模式下高对比度 Tag 文字色彩适配 */
.theme-dark .tag-green  { color: #B4CEAC; }
.theme-dark .tag-orange { color: #F0B894; }
.theme-dark .tag-coffee { color: #E0CFA8; }
.theme-dark .tag-pink   { color: #F0B8BB; }
.theme-dark .tag-blue   { color: #B5D0E8; }
.theme-dark .tag-yellow { color: #F0DE94; }
.theme-dark .tag-purple { color: #D5C2E8; }
.theme-dark .tag-gray   { color: #C5BCB0; }

/* ============== 输入框 ============== */

.input-wrap {
  background-color: var(--tm-bg-card);
  border: 1rpx solid var(--tm-border);
  border-radius: var(--tm-radius-sm);
  padding: 20rpx 26rpx;
  display: flex;
  align-items: center;
  box-shadow: inset 0 1rpx 3rpx rgba(92, 82, 69, 0.04);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.input-wrap:focus-within {
  border-color: var(--tm-primary);
  box-shadow: 0 0 0 4rpx rgba(143, 174, 133, 0.18), inset 0 1rpx 3rpx rgba(92, 82, 69, 0.04);
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--tm-text-primary);
}

.input-placeholder {
  color: var(--tm-text-light);
}

.textarea-wrap {
  background-color: var(--tm-bg-card);
  border: 1rpx solid var(--tm-border);
  border-radius: var(--tm-radius-sm);
  padding: 20rpx 26rpx;
  box-shadow: inset 0 1rpx 3rpx rgba(92, 82, 69, 0.04);
}

.textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  color: var(--tm-text-primary);
  line-height: 1.5;
}

/* ============== 纸艺钢印凹槽图标容器 (Letterpress Debossed Well) ============== */

.icon-circle, .stamp-well {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--tm-radius-well, 22rpx);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
  background-color: var(--tm-bg-inset);
  border: 1rpx solid var(--tm-border-light);
  box-shadow: var(--tm-deboss-well);
  box-sizing: border-box;
  transition: transform 0.18s var(--tm-spring-bounce), box-shadow 0.18s ease;
}

.icon-circle:active, .stamp-well:active {
  box-shadow: var(--tm-deboss-well-active);
  transform: scale(0.95);
}

.icon-circle-green   { background-color: var(--tm-primary-light); border-color: rgba(143, 174, 133, 0.35); color: var(--tm-primary-deep); }
.icon-circle-orange  { background-color: var(--tm-accent-light);  border-color: rgba(232, 168, 124, 0.35); color: var(--tm-accent-deep); }
.icon-circle-coffee  { background-color: var(--tm-coffee-light);  border-color: rgba(184, 153, 104, 0.35); color: var(--tm-coffee); }
.icon-circle-pink    { background-color: var(--tm-pink-light);    border-color: rgba(232, 168, 171, 0.35); color: #B86F65; }
.icon-circle-blue    { background-color: var(--tm-blue-light);    border-color: rgba(160, 184, 204, 0.35); color: #4F7290; }
.icon-circle-yellow  { background-color: var(--tm-yellow-light);  border-color: rgba(224, 200, 117, 0.35); color: #A08030; }
.icon-circle-purple  { background-color: var(--tm-purple-light);  border-color: rgba(181, 160, 200, 0.35); color: #7A6090; }
.icon-circle-gray    { background-color: var(--tm-gray-light);    border-color: rgba(192, 181, 164, 0.35); color: var(--tm-text-muted); }

/* ============== 撕纸小票锯齿边饰 (Torn Paper Edge) ============== */

.paper-edge {
  position: relative;
  width: 100%;
  height: 16rpx;
  background-repeat: repeat-x;
  background-size: 24rpx 16rpx;
}

.paper-edge-top {
  background-image: radial-gradient(circle at 12rpx 0rpx, transparent 10rpx, var(--tm-bg-card) 11rpx);
}

.paper-edge-bottom {
  background-image: radial-gradient(circle at 12rpx 16rpx, transparent 10rpx, var(--tm-bg-card) 11rpx);
}

/* ============== 浮层与弹窗 (Sheet Modal) ============== */

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(20, 18, 16, 0.65);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: var(--tm-z-overlay);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fadeIn 0.22s ease-out;
}

.sheet {
  width: 100%;
  background-color: var(--tm-bg-card);
  border-radius: 40rpx 40rpx 0 0;
  padding: 34rpx 32rpx calc(48rpx + env(safe-area-inset-bottom, 24px));
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.25);
  animation: slideUp 0.28s var(--tm-spring-ease);
}

.sheet-handle {
  width: 68rpx;
  height: 8rpx;
  background-color: var(--tm-border);
  border-radius: 4rpx;
  margin: 0 auto 28rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  text-align: center;
  margin-bottom: 28rpx;
}

/* ============== 工具类 ============== */

.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }

.divider {
  height: 1rpx;
  background-color: var(--tm-divider);
  margin: 20rpx 0;
}

.dotted-divider {
  border-top: 2rpx dashed var(--tm-dotted-line);
  margin: 24rpx 0;
}

.progress-bar {
  width: 100%;
  height: 14rpx;
  background-color: var(--tm-bg-inset);
  border-radius: 8rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(92, 82, 69, 0.14), inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.7);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--tm-primary) 0%, var(--tm-accent) 100%);
  border-radius: 8rpx;
}

/* ============== 阶梯式流体动效 (Staggered Cascade Animations) ============== */

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fadeSlideUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.reveal-1 { animation: fadeSlideUp 0.45s var(--tm-spring-ease) forwards; }
.reveal-2 { animation: fadeSlideUp 0.55s var(--tm-spring-ease) 0.08s forwards; opacity: 0; }
.reveal-3 { animation: fadeSlideUp 0.65s var(--tm-spring-ease) 0.16s forwards; opacity: 0; }
.reveal-4 { animation: fadeSlideUp 0.75s var(--tm-spring-ease) 0.24s forwards; opacity: 0; }

@keyframes scanLaser {
  0% { top: 0%; opacity: 0.8; }
  50% { top: 85%; opacity: 1; }
  100% { top: 0%; opacity: 0.8; }
}

/* ============== 底部温暖寄语体系 (Warm Footer Quotes) ============== */

.bottom-quote {
  text-align: center;
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 40rpx;
  margin-bottom: 24rpx;
  font-style: italic;
  letter-spacing: 0.04em;
  line-height: 1.6;
  opacity: 0.85;
}

/* ============== 手账定制抽屉与弹窗组件 (Handcrafted Sheet & Modal) ============== */

.custom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: var(--tm-bg-sheet);
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 24rpx 36rpx calc(40rpx + env(safe-area-inset-bottom, 24px));
  box-shadow: var(--tm-shadow-float);
  border-top: 1rpx solid var(--tm-border-light);
  animation: slideUp 0.28s var(--tm-spring-ease);
  box-sizing: border-box;
}

.custom-sheet-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.sheet-item-row {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-radius: var(--tm-radius-well, 22rpx);
  margin-bottom: 14rpx;
  background-color: var(--tm-bg-card);
  border: 1rpx solid var(--tm-border-light);
  box-shadow: 0 2rpx 8rpx rgba(184, 153, 104, 0.06);
  cursor: pointer;
  transition: transform 0.16s var(--tm-spring-bounce), background-color 0.16s ease;
  box-sizing: border-box;
}

.sheet-item-row:active {
  transform: scale(0.98);
  background-color: var(--tm-bg-inset);
}

.sheet-item-danger {
  border-color: rgba(184, 111, 101, 0.25);
}

.sheet-item-ico {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-item-ico-img {
  width: 44rpx;
  height: 44rpx;
}

.sheet-item-body {
  flex: 1;
  min-width: 0;
}

.sheet-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
  line-height: 1.3;
}

.sheet-item-sub {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
  line-height: 1.2;
}

.sheet-item-arrow {
  font-size: 32rpx;
  color: var(--tm-text-light);
  margin-left: 12rpx;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-1rpx);
}

.sheet-item-danger .sheet-item-title {
  color: #B86F65;
}

/* 定制手账确认弹窗 (Double-Bezel Confirm Dialog) */
.dialog-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: var(--tm-z-dialog);
  padding: 40rpx;
  box-sizing: border-box;
  animation: fadeIn 0.2s ease;
}

.dialog-box {
  width: 100%;
  max-width: 620rpx;
  animation: fadeSlideUp 0.28s var(--tm-spring-ease);
}

.dialog-core {
  padding: 40rpx 36rpx 36rpx;
  text-align: center;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  margin-bottom: 16rpx;
}

.dialog-desc {
  font-size: 26rpx;
  color: var(--tm-text-secondary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

