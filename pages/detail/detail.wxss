@import "../../styles/tokens.wxss";

.detail-page {
  padding-bottom: 240rpx;
}

.receipt-paper-container {
  position: relative;
  padding-top: 14rpx;
  margin-bottom: 36rpx;
}

.detail-bezel-tray {
  padding: 6rpx;
}

.receipt-paper {
  background-color: var(--tm-bg-card);
  box-shadow: var(--tm-inset-highlight);
  border-radius: var(--tm-radius-core);
  border: 1rpx solid var(--tm-border-highlight);
  overflow: hidden;
  position: relative;
}

.paper-content {
  padding: 24rpx 32rpx 20rpx;
  position: relative;
}

/* 复古手账印章水印 */
.paper-stamp {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  border: 2rpx dashed var(--tm-accent);
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
  transform: rotate(7deg);
  opacity: 0.75;
  pointer-events: none;
}

.stamp-text {
  font-size: 18rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* 商家与日期 */
.paper-header {
  text-align: center;
  padding-top: 16rpx;
}

.paper-mascot {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 16rpx;
  box-shadow: var(--tm-shadow-sm);
}

.paper-mascot-img {
  width: 62rpx;
  height: 62rpx;
}

.paper-merchant {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  letter-spacing: 0.02em;
}

.paper-date {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

/* 金额大字块 */
.paper-amount-block {
  text-align: center;
  padding: 16rpx 0;
}

.paper-amount-label {
  font-size: 20rpx;
  color: var(--tm-text-muted);
  letter-spacing: 0.12em;
  font-weight: 600;
}

.paper-amount {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  margin-top: 6rpx;
  letter-spacing: -0.03em;
  line-height: 1;
}

/* 图片预览 */
.paper-img-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: var(--tm-radius-sm);
  overflow: hidden;
  margin: 16rpx 0 24rpx;
  box-shadow: var(--tm-shadow-sm);
  border: 1rpx solid var(--tm-border-light);
}

.paper-img {
  width: 100%;
  height: 100%;
}

.paper-img-zoom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 25, 20, 0.65);
  color: #FFFFFF;
  font-size: 22rpx;
  text-align: center;
  padding: 10rpx 0;
}

/* 详细清单行 */
.paper-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 10rpx 0;
}

.info-row {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
}

.info-label {
  width: 140rpx;
  color: var(--tm-text-muted);
  flex-shrink: 0;
  font-weight: 600;
}

.info-value {
  flex: 1;
}

.info-value-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-ico {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.info-value-text {
  flex: 1;
  color: var(--tm-text-primary);
  line-height: 1.5;
}

.note-text {
  font-style: italic;
  background: var(--tm-bg-inset);
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  color: var(--tm-text-secondary);
  border: 1rpx solid var(--tm-border-light);
}

/* 底部条形码与印章 */
.paper-tail {
  text-align: center;
  padding: 16rpx 0 10rpx;
}

.barcode-img {
  width: 300rpx;
  height: 68rpx;
  margin: 0 auto 12rpx;
  opacity: 0.65;
}

.paper-tail-tip {
  font-size: 20rpx;
  color: var(--tm-text-light);
}

.paper-tail-id {
  font-size: 18rpx;
  color: var(--tm-text-light);
  margin-top: 6rpx;
  letter-spacing: 0.1em;
}

/* 底部快捷操作栏（Double-Bezel 悬浮岛） */
.detail-actions-tray {
  padding: 6rpx;
}

.detail-actions-core {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 18rpx 10rpx;
}

.action-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
  cursor: pointer;
}

.act-icon-disc {
  width: 72rpx;
  height: 72rpx;
  transition: transform 0.2s var(--tm-spring-bounce);
}

.action-cell:active .act-icon-disc {
  transform: scale(1.1);
}

.detail-act-ico {
  width: 40rpx;
  height: 40rpx;
}

.action-label {
  font-size: 22rpx;
  color: var(--tm-text-secondary);
  margin-top: 10rpx;
  font-weight: 600;
}
