@import "../../styles/tokens.wxss";

.cat-page {
  padding-bottom: 220rpx;
}

/* 顶部标题区（防胶囊遮挡） */
.cat-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10rpx 4rpx 20rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-hero-left {
  flex: 1;
  min-width: 360rpx;
}

.cat-hero-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.cat-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

.cat-add-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--tm-primary) 0%, var(--tm-primary-deep) 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(101, 133, 87, 0.25);
  cursor: pointer;
  transition: transform 0.18s var(--tm-spring-bounce);
  margin-bottom: 4rpx;
  box-sizing: border-box;
}

.cat-add-plus {
  font-size: 32rpx;
  line-height: 1;
  font-weight: bold;
}

/* 横向胶囊滚动栏 */
.cat-capsule-scroll {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 10rpx 24rpx;
  margin-bottom: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 28rpx 0 12rpx;
  background-color: var(--tm-bg-card);
  border: 1rpx solid var(--tm-border-light);
  border-radius: 38rpx;
  margin-right: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(184, 153, 104, 0.08);
  transition: all 0.2s var(--tm-spring-bounce);
  cursor: pointer;
  white-space: nowrap;
  box-sizing: border-box;
}

.cat-chip:first-child {
  margin-left: 6rpx;
}

.cat-chip-active {
  background: var(--tm-primary);
  border-color: var(--tm-primary);
  box-shadow: 0 4rpx 16rpx rgba(101, 133, 87, 0.3);
}

.cat-chip-new {
  border-style: dashed;
  border-color: var(--tm-primary);
  background: var(--tm-bg-inset);
}

.cat-chip-new-plus {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--tm-primary-deep);
}

.cat-chip-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--tm-bg-inset);
  border: 1rpx solid var(--tm-border-light);
  box-shadow: var(--tm-deboss-well);
  box-sizing: border-box;
}

.cat-chip-active .cat-chip-icon {
  background-color: rgba(255, 255, 255, 0.22);
  border-color: rgba(255, 255, 255, 0.45);
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.15), 0 1rpx 2rpx rgba(255, 255, 255, 0.35);
}

.cat-chip-img {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.cat-chip-emoji {
  font-size: 28rpx;
}

.cat-chip-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1;
}

.cat-chip-active .cat-chip-name {
  color: #FFFFFF;
}

/* 分类总览便签卡（Double-Bezel 托盘） */
.cat-summary-tray {
  margin-bottom: 30rpx;
}

.cat-summary-core {
  padding: 30rpx 26rpx 24rpx;
}

.cat-summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-summary-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cat-summary-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--tm-radius-well, 26rpx);
  margin-right: 18rpx;
  flex-shrink: 0;
  background-color: var(--tm-bg-inset);
  border: 1rpx solid var(--tm-border-light);
  box-shadow: var(--tm-deboss-well);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat-sum-img {
  width: 52rpx;
  height: 52rpx;
}

.cat-sum-emoji {
  font-size: 44rpx;
}

.cat-summary-info {
  flex: 1;
  min-width: 0;
}

.cat-summary-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cat-summary-sub {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 6rpx;
}

.cat-summary-amount-box {
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.cat-sum-cur {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  margin-right: 4rpx;
}

.cat-sum-val {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  letter-spacing: -0.02em;
}

.cat-progress-box {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--tm-dotted-line);
}

/* 排序切换小胶囊 */
.sort-toggle-pill {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tm-primary-deep);
  background: var(--tm-primary-light);
  padding: 6rpx 18rpx;
  border-radius: var(--tm-radius-pill);
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  cursor: pointer;
  box-shadow: var(--tm-shadow-sm);
  transition: transform 0.18s var(--tm-spring-bounce);
  overflow: hidden;
}

.sort-toggle-pill:active {
  transform: scale(0.95);
}

.sort-icon {
  font-size: 24rpx;
}

/* 月度分组（一月一册账本托盘） */
.month-group {
  margin-bottom: 0;
}

.month-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 14rpx 14rpx;
  margin: 0 6rpx 2rpx;
  border-bottom: 1rpx dashed var(--tm-dotted-line);
}

.month-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tm-text-secondary);
}

.month-sub-total {
  font-size: 22rpx;
  color: var(--tm-text-muted);
}

/* 弹窗中的图标选择器 */
.icon-picker-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin: 12rpx 0 24rpx;
  max-height: 340rpx;
  overflow-y: auto;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
}

.icon-cell {
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--tm-radius-well, 22rpx);
  background-color: var(--tm-bg-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--tm-border-light);
  box-shadow: var(--tm-deboss-well);
  transition: all 0.18s var(--tm-spring-bounce);
  box-sizing: border-box;
}

.icon-cell-active {
  background-color: var(--tm-bg-card);
  border-color: var(--tm-primary);
  box-shadow: var(--tm-shadow-glow), 0 4rpx 12rpx rgba(101, 133, 87, 0.25);
  transform: scale(1.08);
}

.icon-cell-img {
  width: 52rpx;
  height: 52rpx;
}
