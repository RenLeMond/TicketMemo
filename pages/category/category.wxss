@import "../../styles/tokens.wxss";

.cat-page {
  padding-bottom: 220rpx;
}

/* 顶部标题区（防胶囊遮挡） */
.cat-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10rpx 4rpx 20rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-hero-left {
  flex: 1;
  min-width: 360rpx;
}

.cat-hero-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.cat-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

.cat-add-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: var(--tm-radius-pill);
  background: linear-gradient(135deg, var(--tm-primary) 0%, var(--tm-primary-deep) 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: var(--tm-shadow-glow);
  cursor: pointer;
  overflow: hidden;
  transition: transform 0.18s var(--tm-spring-bounce);
  margin-bottom: 4rpx;
}

.cat-add-plus {
  font-size: 32rpx;
  line-height: 1;
  font-weight: bold;
}

/* 横向胶囊滚动栏 */
.cat-capsule-scroll {
  display: flex;
  white-space: nowrap;
  padding: 12rpx 0 20rpx;
  margin-bottom: 12rpx;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 26rpx 10rpx 12rpx;
  background-color: var(--tm-bg-card);
  border: 1rpx solid var(--tm-border-light);
  border-radius: var(--tm-radius-pill);
  margin-right: 18rpx;
  box-shadow: var(--tm-shadow-sm);
  transition: all 0.2s var(--tm-spring-bounce);
  cursor: pointer;
  overflow: hidden;
}

.cat-chip-active {
  background: var(--tm-primary);
  border-color: var(--tm-primary);
  box-shadow: var(--tm-shadow-glow);
  transform: scale(1.04);
}

.cat-chip-new {
  border-style: dashed;
  border-color: var(--tm-primary);
  background: var(--tm-bg-inset);
}

.cat-chip-new-plus {
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  color: var(--tm-primary-deep);
}

.cat-chip-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
}

.cat-chip-img {
  width: 32rpx;
  height: 32rpx;
}

.cat-chip-emoji {
  font-size: 28rpx;
}

.cat-chip-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.cat-chip-active .cat-chip-name {
  color: #FFFFFF;
}

/* 分类总览便签卡（Double-Bezel 托盘） */
.cat-summary-tray {
  margin-bottom: 30rpx;
}

.cat-summary-core {
  padding: 30rpx 26rpx 24rpx;
}

.cat-summary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-summary-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.cat-summary-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.cat-sum-img {
  width: 52rpx;
  height: 52rpx;
}

.cat-sum-emoji {
  font-size: 44rpx;
}

.cat-summary-info {
  flex: 1;
  min-width: 0;
}

.cat-summary-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cat-summary-sub {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 6rpx;
}

.cat-summary-amount-box {
  display: flex;
  align-items: baseline;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.cat-sum-cur {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  margin-right: 4rpx;
}

.cat-sum-val {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  letter-spacing: -0.02em;
}

.cat-progress-box {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--tm-dotted-line);
}

/* 排序切换小胶囊 */
.sort-toggle-pill {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--tm-primary-deep);
  background: var(--tm-primary-light);
  padding: 6rpx 18rpx;
  border-radius: var(--tm-radius-pill);
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  cursor: pointer;
  box-shadow: var(--tm-shadow-sm);
  transition: transform 0.18s var(--tm-spring-bounce);
  overflow: hidden;
}

.sort-toggle-pill:active {
  transform: scale(0.95);
}

.sort-icon {
  font-size: 24rpx;
}

/* 月度分组 */
.month-group {
  margin-bottom: 30rpx;
}

.month-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 6rpx 14rpx;
}

.month-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tm-text-secondary);
}

.month-sub-total {
  font-size: 22rpx;
  color: var(--tm-text-muted);
}

/* 弹窗中的图标选择器 */
.icon-picker-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16rpx;
  margin: 16rpx 0 28rpx;
  max-height: 320rpx;
  overflow-y: auto;
  padding: 4rpx;
}

.icon-cell {
  width: 90rpx;
  height: 90rpx;
  border-radius: var(--tm-radius-sm);
  background-color: var(--tm-bg-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.18s var(--tm-spring-bounce);
  overflow: hidden;
}

.icon-cell-active {
  background-color: var(--tm-bg-card);
  border-color: var(--tm-primary);
  box-shadow: var(--tm-shadow-glow);
  transform: scale(1.1);
}

.icon-cell-img {
  width: 52rpx;
  height: 52rpx;
}

/* 颜色选择行 */
.color-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0 32rpx;
}

.color-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  transition: transform 0.18s var(--tm-spring-bounce);
  overflow: hidden;
}

.color-dot-active {
  border-color: var(--tm-primary);
  transform: scale(1.18);
  box-shadow: 0 4rpx 12rpx rgba(143, 174, 133, 0.35);
}

.sheet-actions {
  display: flex;
  margin-top: 10rpx;
}
