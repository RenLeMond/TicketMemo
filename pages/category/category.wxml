<view class="page-container cat-page {{themeClass}}">

  <!-- 顶部标题区（避开微信右上角胶囊） -->
  <view class="cat-hero reveal-1">
    <view class="cat-hero-left">
      <view class="eyebrow-tag">CATEGORY ARCHIVE · 分类归档</view>
      <view class="cat-hero-title font-display">分类手账</view>
      <view class="cat-hero-sub">细细分类日常，用心收藏每一份人间烟火 🌿</view>
    </view>
    <view class="cat-add-pill" bindtap="onAddCategory">
      <text class="cat-add-plus">+</text>
      <text>新建分类</text>
    </view>
  </view>

  <!-- 横向滑动分类胶囊栏 -->
  <scroll-view class="cat-capsule-scroll reveal-2" scroll-x enable-flex show-scrollbar="{{false}}">
    <!-- 全部小票胶囊 -->
    <view
      class="cat-chip {{currentId === 'all' ? 'cat-chip-active' : ''}}"
      bindtap="onSwitchCat"
      data-id="all"
    >
      <view class="icon-circle icon-circle-coffee cat-chip-icon">
        <image class="cat-chip-img" src="{{allIcon}}" mode="aspectFit" />
      </view>
      <text class="cat-chip-name">全部</text>
    </view>

    <!-- 各分类胶囊 -->
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-chip {{currentId === item.id ? 'cat-chip-active' : ''}}"
      bindtap="onSwitchCat"
      bindlongpress="onLongPressCat"
      data-id="{{item.id}}"
    >
      <view class="icon-circle icon-circle-{{item.color || 'coffee'}} cat-chip-icon">
        <image wx:if="{{item._iconIsImg}}" class="cat-chip-img" src="{{item.icon}}" mode="aspectFit" />
        <text wx:else class="cat-chip-emoji">{{item.icon}}</text>
      </view>
      <text class="cat-chip-name">{{item.name}}</text>
    </view>

    <!-- 列表末尾新建分类入口 -->
    <view class="cat-chip cat-chip-new" bindtap="onAddCategory">
      <view class="icon-circle icon-circle-green cat-chip-icon">
        <text class="cat-chip-new-plus">+</text>
      </view>
      <text class="cat-chip-name">新建</text>
    </view>
  </scroll-view>

  <!-- 当前选中分类总览便签卡（Double-Bezel 托盘架构） -->
  <view class="bezel-tray cat-summary-tray reveal-2">
    <view class="tape tape-left tape-green"></view>
    <view class="bezel-core cat-summary-core">
      <view class="cat-summary-header">
        <view class="cat-summary-main">
          <view class="icon-circle icon-circle-{{currentSummary.color || 'coffee'}} cat-summary-icon">
            <image wx:if="{{currentSummary._iconIsImg}}" class="cat-sum-img" src="{{currentSummary.icon}}" mode="aspectFit" />
            <text wx:else class="cat-sum-emoji">{{currentSummary.icon}}</text>
          </view>
          <view class="cat-summary-info">
            <view class="cat-summary-title font-display">{{currentSummary.name}}</view>
            <view class="cat-summary-sub">共记录 {{currentSummary.count}} 笔账目 · 占总开支 {{currentSummary.pct}}%</view>
          </view>
        </view>
        <view class="cat-summary-amount-box">
          <text class="cat-sum-cur font-number">¥</text>
          <text class="cat-sum-val font-number">{{currentSummary.total}}</text>
        </view>
      </view>

      <view class="cat-progress-box">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{currentSummary.pct}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 列表小标题与排序小胶囊 -->
  <view class="section-title reveal-3">
    小票时间线
    <view class="sort-toggle-pill" bindtap="onToggleSort">
      <text class="sort-icon">⇅</text>
      <text>{{sortMode === 'date' ? '按最新日期' : '按最高金额'}}</text>
    </view>
  </view>

  <!-- 按月份账本托盘展示小票行 -->
  <view class="reveal-3">
    <block wx:if="{{list.length > 0}}">
      <view wx:for="{{list}}" wx:key="month" class="month-group">
        <view class="bezel-tray ledger-tray">
          <view class="bezel-core ledger-core">
            <view class="month-header">
              <view class="month-label font-display">{{item.month}}</view>
              <view class="month-sub-total font-number">
                {{item.count}} 笔 · 共 ¥{{item.total.toFixed(2)}}
              </view>
            </view>
            <ticket-card
              wx:for="{{item.receipts}}"
              wx:for-item="r"
              wx:for-index="ri"
              wx:key="id"
              receipt="{{r}}"
              showDate="{{true}}"
              variant="ledger"
              isLast="{{ri === item.receipts.length - 1}}"
            />
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="bezel-tray ledger-tray">
      <view class="bezel-core ledger-core">
        <empty-state
          iconSrc="{{emptyIcon}}"
          text="该分类下暂无小票"
          sub="点底部「+」拍照入账一张吧"
        />
      </view>
    </view>
  </view>

  <!-- 分类页底部暖心寄语 -->
  <view class="bottom-quote reveal-4">把零碎的日子分门别类，用心珍藏每一种烟火气 🌿</view>

</view>

<!-- 新建/编辑分类弹窗 -->
<view wx:if="{{showAddModal}}" class="mask" catchtouchmove="" bindtap="onCloseModal">
  <view class="sheet tab-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-title font-display">{{editingCatId ? '编辑分类' : '新建分类'}}</view>

    <view class="form-label">分类名称</view>
    <view class="input-wrap">
      <input
        class="input"
        placeholder="例如 宠物、数码、手办、露营"
        placeholder-class="input-placeholder"
        value="{{newCatName}}"
        bindinput="onCatNameInput"
        maxlength="6"
      />
    </view>

    <view class="form-label" style="margin-top: 20rpx;">选择手账图标</view>
    <view class="icon-picker-grid">
      <view
        wx:for="{{iconOptions}}"
        wx:key="*this"
        class="icon-cell {{newCatIcon === item ? 'icon-cell-active' : ''}}"
        catchtap="onPickIcon"
        data-idx="{{index}}"
      >
        <image class="icon-cell-img" src="{{item}}" mode="aspectFit" />
      </view>
    </view>

    <view class="sheet-actions">
      <view class="btn btn-ghost flex-1" catchtap="onCloseModal">取消</view>
      <view class="btn btn-primary flex-1" catchtap="onSaveCategory">保存分类</view>
    </view>
  </view>
</view>

<!-- 分类长按手账抽屉 (Custom Handcrafted Action Sheet) -->
<view wx:if="{{showCatActionSheet}}" class="mask" catchtouchmove="" bindtap="onCloseCatActionSheet">
  <view class="custom-sheet tab-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="custom-sheet-header">
      <view class="sheet-title font-display" style="margin-bottom: 6rpx;">{{actionCat.name}} · 分类管理</view>
      <view class="sheet-item-sub">自建手账分类管理</view>
    </view>

    <view class="sheet-item-row" catchtap="onActionEditCat">
      <view class="icon-circle icon-circle-coffee sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{funcIcons.edit}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">编辑分类</view>
        <view class="sheet-item-sub">修改分类名称与手账图标</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-item-row sheet-item-danger" catchtap="onActionDeleteCat">
      <view class="icon-circle icon-circle-pink sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{funcIcons.trash}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">删除分类</view>
        <view class="sheet-item-sub">该分类下小票将自动归入「其他」</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-actions" style="margin-top: 24rpx;">
      <view class="btn btn-ghost btn-block" catchtap="onCloseCatActionSheet">取消</view>
    </view>
  </view>
</view>

<!-- 删除分类手账确认弹窗 (Double-Bezel Confirm Dialog) -->
<view wx:if="{{showDeleteConfirm}}" class="dialog-mask" catchtouchmove="" bindtap="onCancelDeleteConfirm">
  <view class="dialog-box" catchtap="noop">
    <view class="bezel-tray">
      <view class="tape tape-center tape-pink"></view>
      <view class="bezel-core dialog-core">
        <view class="dialog-title font-display">删除分类</view>
        <view class="dialog-desc">确定删除「{{actionCat.name}}」吗？\n该分类下小票将自动归入「其他」分类，小票不会丢失。</view>
        <view class="sheet-actions">
          <view class="btn btn-ghost flex-1" catchtap="onCancelDeleteConfirm">取消</view>
          <view class="btn btn-danger flex-1" catchtap="onConfirmDeleteCat">确认删除</view>
        </view>
      </view>
    </view>
  </view>
</view>
