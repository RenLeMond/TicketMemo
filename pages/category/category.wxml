<view class="page-container cat-page {{themeClass}}">

  <!-- 顶部标题区（避开微信右上角胶囊） -->
  <view class="cat-hero reveal-1">
    <view class="cat-hero-left">
      <view class="eyebrow-tag">CATEGORY ARCHIVE · 分类归档</view>
      <view class="cat-hero-title font-display">分类手账</view>
      <view class="cat-hero-sub">长按自建分类可编辑或删除 🌿</view>
    </view>
    <view class="cat-add-pill" bindtap="onAddCategory">
      <text class="cat-add-plus">+</text>
      <text>新建分类</text>
    </view>
  </view>

  <!-- 横向滑动分类胶囊栏 -->
  <scroll-view class="cat-capsule-scroll reveal-2" scroll-x enable-flex show-scrollbar="{{false}}">
    <!-- 全部小票胶囊 -->
    <view
      class="cat-chip {{currentId === 'all' ? 'cat-chip-active' : ''}}"
      bindtap="onSwitchCat"
      data-id="all"
    >
      <view class="icon-circle icon-circle-coffee cat-chip-icon">
        <image class="cat-chip-img" src="{{allIcon}}" mode="aspectFit" />
      </view>
      <text class="cat-chip-name">全部</text>
    </view>

    <!-- 各分类胶囊 -->
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="cat-chip {{currentId === item.id ? 'cat-chip-active' : ''}}"
      bindtap="onSwitchCat"
      bindlongpress="onLongPressCat"
      data-id="{{item.id}}"
    >
      <view class="icon-circle icon-circle-{{item.color || 'coffee'}} cat-chip-icon">
        <image wx:if="{{item._iconIsImg}}" class="cat-chip-img" src="{{item.icon}}" mode="aspectFit" />
        <text wx:else class="cat-chip-emoji">{{item.icon}}</text>
      </view>
      <text class="cat-chip-name">{{item.name}}</text>
    </view>

    <!-- 列表末尾新建分类入口 -->
    <view class="cat-chip cat-chip-new" bindtap="onAddCategory">
      <view class="icon-circle icon-circle-green cat-chip-icon">
        <text class="cat-chip-new-plus">+</text>
      </view>
      <text class="cat-chip-name">新建</text>
    </view>
  </scroll-view>

  <!-- 当前选中分类总览便签卡（Double-Bezel 托盘架构） -->
  <view class="bezel-tray cat-summary-tray reveal-2">
    <view class="tape tape-left tape-green"></view>
    <view class="bezel-core cat-summary-core">
      <view class="cat-summary-header">
        <view class="cat-summary-main">
          <view class="icon-circle icon-circle-{{currentSummary.color || 'coffee'}} cat-summary-icon">
            <image wx:if="{{currentSummary._iconIsImg}}" class="cat-sum-img" src="{{currentSummary.icon}}" mode="aspectFit" />
            <text wx:else class="cat-sum-emoji">{{currentSummary.icon}}</text>
          </view>
          <view class="cat-summary-info">
            <view class="cat-summary-title font-display">{{currentSummary.name}}</view>
            <view class="cat-summary-sub">共记录 {{currentSummary.count}} 笔账目 · 占总开支 {{currentSummary.pct}}%</view>
          </view>
        </view>
        <view class="cat-summary-amount-box">
          <text class="cat-sum-cur font-number">¥</text>
          <text class="cat-sum-val font-number">{{currentSummary.total}}</text>
        </view>
      </view>

      <view class="cat-progress-box">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{currentSummary.pct}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 列表小标题与排序小胶囊 -->
  <view class="section-title reveal-3">
    小票时间线
    <view class="sort-toggle-pill" bindtap="onToggleSort">
      <text class="sort-icon">⇅</text>
      <text>{{sortMode === 'date' ? '按最新日期' : '按最高金额'}}</text>
    </view>
  </view>

  <!-- 按月份时间线展示小票卡片 -->
  <view class="reveal-3">
    <block wx:if="{{list.length > 0}}">
      <view wx:for="{{list}}" wx:key="month" class="month-group">
        <view class="month-header">
          <view class="month-label font-display">{{item.month}}</view>
          <view class="month-sub-total font-number">
            {{item.count}} 笔 · 共 ¥{{item.total.toFixed(2)}}
          </view>
        </view>
        <ticket-card
          wx:for="{{item.receipts}}"
          wx:for-item="r"
          wx:key="id"
          receipt="{{r}}"
          showDate="{{true}}"
        />
      </view>
    </block>

    <empty-state
      wx:else
      iconSrc="{{emptyIcon}}"
      text="该分类下暂无小票"
      sub="点底部「+」拍照入账一张吧"
    />
  </view>

</view>

<!-- 新建/编辑分类弹窗 -->
<view wx:if="{{showAddModal}}" class="mask" catchtouchmove="">
  <view class="sheet" catchtap="">
    <view class="sheet-handle"></view>
    <view class="sheet-title">{{editingCatId ? '编辑分类' : '新建分类'}}</view>

    <view class="form-label">分类名称</view>
    <view class="input-wrap">
      <input
        class="input"
        placeholder="例如 宠物、数码、手办、露营"
        placeholder-class="input-placeholder"
        value="{{newCatName}}"
        bindinput="onCatNameInput"
        maxlength="6"
      />
    </view>

    <view class="form-label">选择手账图标</view>
    <view class="icon-picker-grid">
      <view
        wx:for="{{iconOptions}}"
        wx:key="*this"
        class="icon-cell {{newCatIcon === item ? 'icon-cell-active' : ''}}"
        bindtap="onPickIcon"
        data-idx="{{index}}"
      >
        <image class="icon-cell-img" src="{{item}}" mode="aspectFit" />
      </view>
    </view>

    <view class="form-label">色彩标签</view>
    <view class="color-row">
      <view
        wx:for="{{colorOptions}}"
        wx:key="*this"
        class="color-dot icon-circle-{{item}} {{newCatColor === item ? 'color-dot-active' : ''}}"
        bindtap="onPickColor"
        data-color="{{item}}"
      ></view>
    </view>

    <view class="sheet-actions">
      <view class="btn btn-ghost flex-1 mr-8" bindtap="onCloseModal">取消</view>
      <view class="btn btn-primary flex-1" bindtap="onSaveCategory">保存分类</view>
    </view>
  </view>
</view>
