<view class="page-container exp-page {{themeClass}}">

  <view class="nav-back-bar reveal-1">
    <view class="nav-back-btn" bindtap="goBack"></view>
    <view class="nav-page-title font-display">导出与数据备份</view>
  </view>

  <view class="exp-hero reveal-1">
    <view class="exp-cover icon-circle icon-circle-orange">
      <image class="exp-cover-img" src="{{icons.export}}" mode="aspectFit" />
    </view>
    <view class="exp-hero-info">
      <view class="eyebrow-tag">DATA ARCHIVE · 离线归档</view>
      <view class="exp-hero-title font-display">台账导出与备份</view>
      <view class="exp-hero-sub">支持 Excel、报销台账与 100% 纯本地离线备份</view>
    </view>
  </view>

  <!-- 范围选择 -->
  <view class="section-title reveal-2">导出范围</view>
  <view class="bezel-tray exp-bezel-tray reveal-2">
    <view class="bezel-core exp-bezel-core">
      <view class="range-row">
        <view
          class="range-card {{range === 'all' ? 'range-card-active' : ''}}"
          bindtap="onSwitchRange"
          data-range="all"
        >
          <image class="range-ico" src="{{icons.misc}}" mode="aspectFit" />
          <view class="range-name">全部小票</view>
        </view>
        <view
          class="range-card {{range === 'month' ? 'range-card-active' : ''}}"
          bindtap="onSwitchRange"
          data-range="month"
        >
          <image class="range-ico" src="{{icons.calendar}}" mode="aspectFit" />
          <view class="range-name">指定月份</view>
        </view>
        <view
          class="range-card {{range === 'event' ? 'range-card-active' : ''}}"
          bindtap="onSwitchRange"
          data-range="event"
        >
          <image class="range-ico" src="{{icons.tag}}" mode="aspectFit" />
          <view class="range-name">事件/单张</view>
        </view>
      </view>

      <picker wx:if="{{range === 'month'}}" mode="date" fields="month" value="{{monthValue}}" bindchange="onMonthChange">
        <view class="month-pick">
          <text class="month-label">选择归档月份</text>
          <text class="month-value font-number">{{monthValue || '点击选择'}} ›</text>
        </view>
      </picker>

      <view wx:if="{{eventInfo}}" class="event-info-box">
        <view class="icon-circle icon-circle-{{eventInfo.coverColor}}">
          <image class="event-cover-img" src="{{eventInfo.coverSrc}}" mode="aspectFit" />
        </view>
        <view class="event-info-name">已锁定事件：{{eventInfo.name}}</view>
      </view>

      <view class="exp-summary">
        当前就绪共 <text class="exp-summary-count font-number">{{receiptCount}}</text> 笔小票将被导出
      </view>
    </view>
  </view>

  <!-- 格式 -->
  <view class="section-title reveal-3">导出格式</view>
  <view class="bezel-tray exp-bezel-tray reveal-3">
    <view class="bezel-core exp-bezel-core">
      <view class="fmt-row">
        <view
          class="fmt-card {{format === 'excel' ? 'fmt-card-active' : ''}}"
          bindtap="onSwitchFormat"
          data-format="excel"
        >
          <view class="fmt-tag fmt-tag-green">推荐</view>
          <image class="fmt-ico" src="{{icons.excel}}" mode="aspectFit" />
          <view class="fmt-name">Excel 台账</view>
          <view class="fmt-sub">标准 CSV 表格数据</view>
        </view>
        <view
          class="fmt-card {{format === 'pdf' ? 'fmt-card-active' : ''}}"
          bindtap="onSwitchFormat"
          data-format="pdf"
        >
          <view class="fmt-tag fmt-tag-pink">文档</view>
          <image class="fmt-ico" src="{{icons.pdf}}" mode="aspectFit" />
          <view class="fmt-name">PDF 报销清单</view>
          <view class="fmt-sub">适合打印与报销存档</view>
        </view>
        <view
          class="fmt-card {{format === 'images' ? 'fmt-card-active' : ''}}"
          bindtap="onSwitchFormat"
          data-format="images"
        >
          <view class="fmt-tag fmt-tag-orange">照片</view>
          <image class="fmt-ico" src="{{icons.album}}" mode="aspectFit" />
          <view class="fmt-name">小票原图合集</view>
          <view class="fmt-sub">原始拍摄照片</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 导出选项 -->
  <view class="section-title reveal-3">导出选项</view>
  <view class="bezel-tray exp-bezel-tray reveal-3">
    <view class="bezel-core opt-core">
      <view class="opt-row">
        <view class="opt-text">
          <view class="opt-title">包含备注与手账随笔</view>
          <view class="opt-sub">将记录的心情随笔也一并导出</view>
        </view>
        <switch checked="{{includeNote}}" bindchange="onToggleNote" color="#8FAE85" />
      </view>
      <view class="menu-divider"></view>
      <view class="opt-row">
        <view class="opt-text">
          <view class="opt-title">包含小票标签与商品明细</view>
          <view class="opt-sub">导出每笔账目的商品详情</view>
        </view>
        <switch checked="{{includeImage}}" bindchange="onToggleImage" color="#8FAE85" />
      </view>
    </view>
  </view>

  <view class="btn btn-block btn-primary reveal-3" bindtap="onExport">开始生成并导出</view>

  <!-- 数据备份与导入恢复 -->
  <view class="section-title reveal-4">数据安全与恢复</view>
  <view class="bezel-tray exp-bezel-tray reveal-4">
    <view class="bezel-core menu-bezel-core">
      <view class="menu-row" bindtap="onBackupLocal">
        <view class="icon-circle icon-circle-green">
          <image class="menu-ico" src="{{icons.encrypt}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">本地加密备份</view>
          <view class="menu-sub">生成完整 JSON 备份文本码</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row" bindtap="onOpenImport">
        <view class="icon-circle icon-circle-orange">
          <image class="menu-ico" src="{{icons.restore}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">从备份文本导入恢复</view>
          <view class="menu-sub">粘贴 JSON 备份码一键还原数据</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row" bindtap="onBackupCloud">
        <view class="icon-circle icon-circle-blue">
          <image class="menu-ico" src="{{icons.backup}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">私密安全承诺</view>
          <view class="menu-sub">纯离线管理 · 绝无云端数据外泄</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="bottom-tip reveal-4">所有导出与备份均在你的手机本地完成，保障 100% 隐私安全</view>
</view>

<!-- 导入恢复弹窗 -->
<view wx:if="{{showImportModal}}" class="mask" catchtouchmove="">
  <view class="sheet" catchtap="">
    <view class="sheet-handle"></view>
    <view class="sheet-title">从备份文本恢复数据</view>

    <view class="form-label">粘贴备份 JSON 文本</view>
    <view class="textarea-wrap">
      <textarea
        class="textarea import-textarea"
        placeholder="在此粘贴此前导出的完整 JSON 备份码..."
        placeholder-style="color: var(--tm-text-light);"
        value="{{importJSONText}}"
        bindinput="onImportInput"
        maxlength="100000"
      ></textarea>
    </view>

    <view class="import-notice">
      ⚠️ 恢复将合并小票记录，请确保备份数据来源可信。
    </view>

    <view class="sheet-actions">
      <view class="btn btn-ghost flex-1 mr-8" bindtap="onCloseImport">取消</view>
      <view class="btn btn-primary flex-1" bindtap="onConfirmImport">确认恢复</view>
    </view>
  </view>
</view>
