<view class="page-container exp-page">

  <view class="exp-hero">
    <view class="exp-cover">
      <image class="exp-cover-img" src="/assets/icons/func/export@3x.png" mode="aspectFit" />
    </view>
    <view class="exp-hero-title">导出与备份</view>
    <view class="exp-hero-sub">把生活打包成一份小礼物</view>
  </view>

  <!-- 范围选择 -->
  <view class="section-title">导出范围</view>
  <view class="card">
    <view class="range-row">
      <view
        class="range-card {{range === 'all' ? 'range-card-active' : ''}}"
        bindtap="onSwitchRange"
        data-range="all"
      >
        <image class="range-ico" src="/assets/icons/category/misc@3x.png" mode="aspectFit" />
        <view class="range-name">全部小票</view>
      </view>
      <view
        class="range-card {{range === 'month' ? 'range-card-active' : ''}}"
        bindtap="onSwitchRange"
        data-range="month"
      >
        <image class="range-ico" src="/assets/icons/func/calendar@3x.png" mode="aspectFit" />
        <view class="range-name">指定月份</view>
      </view>
      <view
        class="range-card {{range === 'event' ? 'range-card-active' : ''}}"
        bindtap="onSwitchRange"
        data-range="event"
      >
        <image class="range-ico" src="/assets/icons/func/tag@3x.png" mode="aspectFit" />
        <view class="range-name">事件 / 单张</view>
      </view>
    </view>

    <picker wx:if="{{range === 'month'}}" mode="date" fields="month" value="{{monthValue}}" bindchange="onMonthChange">
      <view class="month-pick">
        <text>选择月份</text>
        <text class="month-value">{{monthValue || '点击选择'}} ›</text>
      </view>
    </picker>

    <view wx:if="{{eventInfo}}" class="event-info">
      <view class="icon-circle icon-circle-{{eventInfo.coverColor}}">
        <image class="event-cover-img" src="{{eventInfo.coverSrc}}" mode="aspectFit" />
      </view>
      <view class="event-info-name">{{eventInfo.name}}</view>
    </view>

    <view class="exp-summary">
      当前共 <text class="exp-summary-count">{{receiptCount}}</text> 张小票将被导出
    </view>
  </view>

  <!-- 格式 -->
  <view class="section-title">导出格式</view>
  <view class="card">
    <view class="fmt-row">
      <view
        class="fmt-card {{format === 'pdf' ? 'fmt-card-active' : ''}}"
        bindtap="onSwitchFormat"
        data-format="pdf"
      >
        <view class="fmt-tag">PDF</view>
        <image class="fmt-ico" src="/assets/icons/func/pdf@3x.png" mode="aspectFit" />
        <view class="fmt-name">PDF 文档</view>
        <view class="fmt-sub">适合打印、报销</view>
      </view>
      <view
        class="fmt-card {{format === 'excel' ? 'fmt-card-active' : ''}}"
        bindtap="onSwitchFormat"
        data-format="excel"
      >
        <view class="fmt-tag fmt-tag-orange">Excel</view>
        <image class="fmt-ico" src="/assets/icons/func/excel@3x.png" mode="aspectFit" />
        <view class="fmt-name">Excel 台账</view>
        <view class="fmt-sub">商家/金额/分类</view>
      </view>
      <view
        class="fmt-card {{format === 'images' ? 'fmt-card-active' : ''}}"
        bindtap="onSwitchFormat"
        data-format="images"
      >
        <view class="fmt-tag fmt-tag-pink">JPG</view>
        <image class="fmt-ico" src="/assets/icons/func/album@3x.png" mode="aspectFit" />
        <view class="fmt-name">图片合集</view>
        <view class="fmt-sub">原图打包</view>
      </view>
    </view>
  </view>

  <!-- 选项 -->
  <view class="section-title">导出选项</view>
  <view class="card opt-card">
    <view class="opt-row">
      <view class="opt-text">
        <view class="opt-title">包含备注</view>
        <view class="opt-sub">备注与标签也一起带走</view>
      </view>
      <switch checked="{{includeNote}}" bindchange="onToggleNote" color="#8FAE85" />
    </view>
    <view class="menu-divider"></view>
    <view class="opt-row">
      <view class="opt-text">
        <view class="opt-title">包含小票图片</view>
        <view class="opt-sub">关闭后仅导出文字信息</view>
      </view>
      <switch checked="{{includeImage}}" bindchange="onToggleImage" color="#8FAE85" />
    </view>
    <view class="menu-divider"></view>
    <view class="opt-row">
      <view class="opt-text">
        <view class="opt-title">加密导出</view>
        <view class="opt-sub">导出文件需密码打开</view>
      </view>
      <switch checked="{{encrypt}}" bindchange="onToggleEncrypt" color="#8FAE85" />
    </view>
  </view>

  <view class="btn btn-block btn-primary" bindtap="onExport">开始导出</view>

  <!-- 备份 -->
  <view class="section-title">数据备份</view>
  <view class="card menu-card">
    <view class="menu-row" bindtap="onBackupLocal">
      <view class="icon-circle icon-circle-green">
        <image class="menu-ico" src="/assets/icons/func/encrypt@3x.png" mode="aspectFit" />
      </view>
      <view class="menu-text">
        <view class="menu-title">本地加密备份</view>
        <view class="menu-sub">保存到小程序本地缓存</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-row" bindtap="onBackupCloud">
      <view class="icon-circle icon-circle-blue">
        <image class="menu-ico" src="/assets/icons/func/backup@3x.png" mode="aspectFit" />
      </view>
      <view class="menu-text">
        <view class="menu-title">私有云备份</view>
        <view class="menu-sub">微信文件 / 个人网盘</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-row" bindtap="onImport">
      <view class="icon-circle icon-circle-orange">
        <image class="menu-ico" src="/assets/icons/func/restore@3x.png" mode="aspectFit" />
      </view>
      <view class="menu-text">
        <view class="menu-title">从本地导入</view>
        <view class="menu-sub">恢复以往备份</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="bottom-tip">所有导出 / 备份操作均在本机完成，不会上传任何数据</view>
</view>
