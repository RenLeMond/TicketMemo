@import "../../styles/tokens.wxss";

.exp-page {
  padding-bottom: 220rpx;
}

.exp-hero {
  display: flex;
  align-items: center;
  padding: 10rpx 4rpx 24rpx;
}

.exp-cover {
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: var(--tm-shadow-sm);
}

.exp-cover-img {
  width: 60rpx;
  height: 60rpx;
}

.exp-hero-info {
  min-width: 0;
  flex: 1;
}

.exp-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  letter-spacing: 0.02em;
}

.exp-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 6rpx;
}

/* 托盘 */
.exp-bezel-tray {
  margin-bottom: 28rpx;
}

.exp-bezel-core {
  padding: 24rpx 20rpx 20rpx;
}

/* 范围选择 */
.range-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.range-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 10rpx;
  border-radius: var(--tm-radius-sm);
  background: var(--tm-bg-inset);
  border: 2rpx solid transparent;
  transition: all 0.18s var(--tm-spring-bounce);
  cursor: pointer;
}

.range-card-active {
  background: var(--tm-primary-light);
  border-color: var(--tm-primary);
  box-shadow: var(--tm-shadow-glow);
  transform: scale(1.03);
}

.range-ico {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 12rpx;
}

.range-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.month-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: var(--tm-bg-card-subtle);
  border-radius: var(--tm-radius-sm);
  border: 1rpx solid var(--tm-border-light);
  margin: 12rpx 0;
}

.month-label {
  font-size: 26rpx;
  color: var(--tm-text-primary);
  font-weight: 500;
}

.month-value {
  font-size: 26rpx;
  color: var(--tm-primary-deep);
  font-weight: 700;
}

.event-info-box {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--tm-bg-card-subtle);
  border-radius: var(--tm-radius-sm);
  margin: 12rpx 0;
  gap: 16rpx;
}

.event-cover-img {
  width: 48rpx;
  height: 48rpx;
}

.event-info-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.exp-summary {
  font-size: 24rpx;
  color: var(--tm-text-secondary);
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--tm-dotted-line);
}

.exp-summary-count {
  color: var(--tm-accent-deep);
  font-weight: 800;
  font-size: 28rpx;
}

/* 导出格式 */
.fmt-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.fmt-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 10rpx 24rpx;
  border-radius: var(--tm-radius-sm);
  background: var(--tm-bg-inset);
  border: 2rpx solid transparent;
  transition: all 0.18s var(--tm-spring-bounce);
  cursor: pointer;
}

.fmt-card-active {
  background: var(--tm-bg-card);
  border-color: var(--tm-accent);
  box-shadow: 0 4rpx 14rpx rgba(232, 168, 124, 0.28);
  transform: scale(1.03);
}

.fmt-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--tm-primary);
  color: #FFFFFF;
  font-weight: bold;
}

.fmt-tag-pink { background: var(--tm-pink); }
.fmt-tag-orange { background: var(--tm-accent); }

.fmt-ico {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
}

.fmt-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
}

.fmt-sub {
  font-size: 18rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
}

/* 选项卡片 */
.opt-core {
  padding: 12rpx 24rpx;
}

.opt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.opt-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.opt-sub {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
}

/* 菜单列表行 */
.menu-bezel-core {
  padding: 6rpx 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  cursor: pointer;
}

.menu-ico {
  width: 44rpx;
  height: 44rpx;
}

.menu-text {
  flex: 1;
  margin-left: 20rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.menu-sub {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--tm-text-light);
  font-weight: bold;
}

.menu-divider {
  height: 1rpx;
  background-color: var(--tm-divider);
}

.bottom-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 24rpx;
}

/* 导入恢复弹窗 */
.import-textarea {
  height: 240rpx;
}

.import-notice {
  font-size: 22rpx;
  color: var(--tm-accent-deep);
  margin-top: 16rpx;
  line-height: 1.4;
}
