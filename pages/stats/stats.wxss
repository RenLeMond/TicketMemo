@import "../../styles/tokens.wxss";

.stat-page {
  padding-bottom: 220rpx;
}

.stat-hero {
  padding: 8rpx 4rpx 24rpx;
}

.stat-hero-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  letter-spacing: 0.03em;
}

.stat-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 6rpx;
}

/* 时间跨度分段选择器 */
.range-tabs {
  display: flex;
  background-color: var(--tm-bg-card);
  border-radius: var(--tm-radius-pill);
  padding: 8rpx;
  border: 1rpx solid var(--tm-border-light);
  margin-bottom: 28rpx;
  box-shadow: var(--tm-shadow-sm);
}

.range-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tm-text-secondary);
  border-radius: var(--tm-radius-pill);
  transition: all 0.22s var(--tm-spring-bounce);
}

.range-tab-active {
  background: var(--tm-primary);
  color: #FFFFFF;
  box-shadow: var(--tm-shadow-glow);
  transform: scale(1.02);
}

/* 总览卡片（Double-Bezel） */
.overview-bezel-tray {
  margin-bottom: 32rpx;
}

.overview-core {
  padding: 32rpx 28rpx 24rpx;
}

.overview-card-bg {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0.08;
  pointer-events: none;
}

.overview-card-bg-img {
  width: 140rpx;
  height: 140rpx;
}

.overview-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.overview-card-label {
  font-size: 26rpx;
  color: var(--tm-text-secondary);
  font-weight: 600;
}

.overview-card-amount {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  margin: 12rpx 0 16rpx;
  letter-spacing: -0.03em;
  line-height: 1;
}

.overview-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--tm-dotted-line);
}

.overview-card-meta {
  font-size: 22rpx;
  color: var(--tm-text-muted);
}

.highlight-text {
  color: var(--tm-text-primary);
  font-weight: 700;
}

/* 环形饼图（Double-Bezel） */
.pie-bezel-tray {
  margin-bottom: 30rpx;
}

.pie-core {
  padding: 28rpx 20rpx;
}

.pie-wrap {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  margin: 10rpx auto 26rpx;
}

.pie-canvas {
  width: 100%;
  height: 100%;
}

.pie-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
}

.pie-center-label {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  font-weight: 500;
}

.pie-center-amount {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  margin-top: 2rpx;
}

.pie-legend {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 10rpx;
}

.pie-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--tm-divider);
}

.pie-row:last-child {
  border-bottom: none;
}

.pie-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.pie-cat-ico {
  width: 34rpx;
  height: 34rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.pie-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
  flex: 1;
}

.pie-pct {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-right: 20rpx;
  font-weight: 600;
}

.pie-amt {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tm-accent-deep);
}

/* 消费趋势柱状图（Double-Bezel） */
.trend-bezel-tray {
  margin-bottom: 30rpx;
}

.trend-core {
  padding: 26rpx 16rpx 18rpx;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 240rpx;
  padding-top: 20rpx;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
  cursor: pointer;
  padding: 0 2rpx;
}

.trend-bar-track {
  width: 22rpx;
  height: 180rpx;
  background-color: var(--tm-bg-inset);
  border-radius: 12rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.trend-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, var(--tm-accent) 0%, var(--tm-primary) 100%);
  border-radius: 12rpx;
  transition: height 0.35s var(--tm-spring-bounce);
}

.trend-col-active .trend-bar-fill {
  background: var(--tm-accent-deep);
  box-shadow: 0 0 14rpx rgba(232, 168, 124, 0.6);
}

.trend-label {
  font-size: 20rpx;
  color: var(--tm-text-muted);
  margin-top: 12rpx;
  font-family: monospace;
}

.trend-col-active .trend-label {
  color: var(--tm-primary-deep);
  font-weight: bold;
}

/* Top 4 排行榜（Double-Bezel） */
.top-bezel-tray {
  margin-bottom: 30rpx;
}

.top-core {
  padding: 16rpx 20rpx;
}

.top-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--tm-divider);
}

.top-row:last-child {
  border-bottom: none;
}

.top-medal-well {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--tm-bg-inset);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  margin-right: 14rpx;
  flex-shrink: 0;
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.08);
}

.top-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
}

.top-cat-img {
  width: 40rpx;
  height: 40rpx;
}

.top-body {
  flex: 1;
  min-width: 0;
}

.top-row-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.top-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.top-amt {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--tm-accent-deep);
}
