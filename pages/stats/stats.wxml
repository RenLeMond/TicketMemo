<view class="page-container stat-page {{themeClass}}">

  <view class="nav-back-bar reveal-1">
    <view class="nav-back-btn" bindtap="goBack"></view>
    <view class="nav-page-title font-display">开支手账统计</view>
  </view>

  <view class="stat-hero reveal-1">
    <view>
      <view class="eyebrow-tag">FINANCIAL RADAR · 开支罗盘</view>
      <view class="stat-hero-title font-display">数据罗盘</view>
      <view class="stat-hero-sub">看清这段日子的消费脉络与小确幸 🌿</view>
    </view>
  </view>

  <!-- 周/月/年分段选择器 -->
  <view class="range-tabs reveal-2">
    <view
      class="range-tab {{range === 'week' ? 'range-tab-active' : ''}}"
      bindtap="switchRange" data-range="week"
    >本周</view>
    <view
      class="range-tab {{range === 'month' ? 'range-tab-active' : ''}}"
      bindtap="switchRange" data-range="month"
    >本月</view>
    <view
      class="range-tab {{range === 'year' ? 'range-tab-active' : ''}}"
      bindtap="switchRange" data-range="year"
    >本年</view>
  </view>

  <!-- 周期总览卡片（Double-Bezel 双层托盘） -->
  <view class="bezel-tray overview-bezel-tray reveal-2">
    <view class="tape tape-left tape-green"></view>

    <view class="bezel-core overview-core">
      <view class="overview-card-bg">
        <image class="overview-card-bg-img" src="{{icons.stats}}" mode="aspectFit" />
      </view>
      <view class="overview-card-row">
        <view class="overview-card-label">{{rangeText}}消费合计</view>
        <view class="overview-card-count tag tag-green">{{monthCount}} 笔小票</view>
      </view>
      <view class="overview-card-amount font-number">¥{{monthTotal}}</view>
      <view class="overview-card-footer">
        <view class="overview-card-meta">日均开支 <text class="font-number highlight-text">¥{{avgDay}}</text></view>
        <view class="overview-card-meta">纯本地离线统计</view>
      </view>
    </view>
  </view>

  <!-- 分类占比（Canvas 2D 环形图 + 莫兰迪图例列表） -->
  <view class="section-title reveal-3">分类消费占比</view>
  <view class="bezel-tray pie-bezel-tray reveal-3">
    <view class="bezel-core pie-core">
      <view class="pie-wrap">
        <canvas type="2d" id="pieCanvas" class="pie-canvas"></canvas>
        <view class="pie-center">
          <view class="pie-center-label">总开支</view>
          <view class="pie-center-amount font-number">¥{{monthTotal}}</view>
        </view>
      </view>
      <view class="pie-legend">
        <view wx:for="{{pieList}}" wx:key="id" class="pie-row">
          <view class="pie-dot" style="background-color: {{item.hex}};"></view>
          <image class="pie-cat-ico" src="{{item.icon}}" mode="aspectFit" />
          <view class="pie-name">{{item.name}}</view>
          <view class="pie-pct font-number">{{item.pct}}%</view>
          <view class="pie-amt font-number">¥{{item.amount}}</view>
        </view>
        <view wx:if="{{pieList.length === 0}}" class="empty">
          <image class="empty-ico" src="{{icons.empty}}" mode="aspectFit" />
          <view class="empty-text">这段时间还没有小票记录</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 消费趋势柱状图 -->
  <view class="section-title reveal-4">
    消费趋势分布
    <text wx:if="{{activeTrendInfo}}" class="section-subtitle">{{activeTrendInfo.label}}开支: ¥{{activeTrendInfo.value}}</text>
  </view>
  <view class="bezel-tray trend-bezel-tray reveal-4">
    <view class="bezel-core trend-core">
      <view class="trend-bars">
        <view
          wx:for="{{trendList}}"
          wx:key="idx"
          class="trend-col {{activeTrendIdx === index ? 'trend-col-active' : ''}}"
          bindtap="onTapTrendBar"
          data-idx="{{index}}"
        >
          <view class="trend-bar-track">
            <view class="trend-bar-fill" style="height: {{item.h}}%;"></view>
          </view>
          <view class="trend-label">{{item.label}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 本期 Top 分类榜单 -->
  <view class="section-title reveal-4" wx:if="{{topCats.length > 0}}">本期 Top 消费排行榜</view>
  <view class="bezel-tray top-bezel-tray reveal-4" wx:if="{{topCats.length > 0}}">
    <view class="bezel-core top-core">
      <view wx:for="{{topCats}}" wx:key="id" class="top-row">
        <view class="top-medal-well font-number">{{item.rank}}</view>
        <view class="icon-circle icon-circle-{{item.color}} top-icon-wrap">
          <image class="top-cat-img" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="top-body">
          <view class="top-row-head">
            <view class="top-name">{{item.name}}</view>
            <view class="top-amt font-number">¥{{item.amount}} ({{item.pct}}%)</view>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.pct}}%;"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <empty-state
    wx:if="{{pieList.length === 0 && monthCount === 0}}"
    iconSrc="{{icons.empty}}"
    text="还没有统计数据呢"
    sub="录入一些小票后再回来看看吧"
  />
</view>
