.st-page { padding-bottom: 80rpx; }

.st-hero {
  text-align: center;
  padding: 18rpx 0 18rpx;
}
.st-cover {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  margin: 0 auto 14rpx;
  background: linear-gradient(135deg, #DCE9D1 0%, #B8D4AE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(143, 174, 133, 0.3);
}
.st-cover-img {
  width: 72rpx;
  height: 72rpx;
}
.st-hero-title { font-size: 36rpx; color: #5C4A3A; font-weight: 600; }
.st-hero-sub { font-size: 24rpx; color: #A89C8A; margin-top: 6rpx; }

.menu-card { padding: 8rpx 24rpx; }
.menu-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}
.menu-row .icon-circle {
  width: 76rpx;
  height: 76rpx;
  margin-right: 22rpx;
}
.st-menu-ico {
  width: 40rpx;
  height: 40rpx;
}
.menu-text { flex: 1; }
.menu-title { font-size: 28rpx; color: #5C4A3A; }
.menu-sub { font-size: 22rpx; color: #A89C8A; margin-top: 6rpx; }
.menu-arrow { font-size: 36rpx; color: #C9BDA8; }
.menu-divider { height: 1rpx; background-color: #EFE6D1; margin-left: 98rpx; }

/* 主题 */
.theme-card { padding: 28rpx 22rpx; }
.theme-row { display: flex; gap: 18rpx; }
.theme-cell {
  flex: 1;
  border-radius: 22rpx;
  border: 2rpx solid transparent;
  padding: 18rpx 14rpx 22rpx;
  text-align: center;
  background-color: #FAF6EE;
}
.theme-cell-active { border-color: #8FAE85; background-color: #FFFCF7; }

.theme-preview {
  width: 100%;
  height: 110rpx;
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  position: relative;
  overflow: hidden;
}
.theme-light { background: linear-gradient(135deg, #FAF6EE 0%, #FFFCF7 100%); }
.theme-green { background: linear-gradient(135deg, #DCE9D1 0%, #B8D4AE 100%); }
.theme-dark  { background: linear-gradient(135deg, #5C4A3A 0%, #8B7355 100%); }

.theme-dot {
  position: absolute;
  border-radius: 50%;
}
.theme-dot-1 { width: 28rpx; height: 28rpx; background-color: #E8A87C; top: 22rpx; left: 22rpx; }
.theme-dot-2 { width: 28rpx; height: 28rpx; background-color: #B89968; top: 22rpx; left: 56rpx; }
.theme-dot-3 { width: 28rpx; height: 28rpx; background-color: #8FAE85; top: 22rpx; left: 90rpx; }

.theme-dot-g1 { width: 28rpx; height: 28rpx; background-color: #FFFCF7; top: 22rpx; left: 22rpx; }
.theme-dot-g2 { width: 28rpx; height: 28rpx; background-color: #E8A87C; top: 22rpx; left: 56rpx; }
.theme-dot-g3 { width: 28rpx; height: 28rpx; background-color: #6B8C5E; top: 22rpx; left: 90rpx; }

.theme-dot-d1 { width: 28rpx; height: 28rpx; background-color: #FAF6EE; top: 22rpx; left: 22rpx; }
.theme-dot-d2 { width: 28rpx; height: 28rpx; background-color: #C9BDA8; top: 22rpx; left: 56rpx; }
.theme-dot-d3 { width: 28rpx; height: 28rpx; background-color: #E8A87C; top: 22rpx; left: 90rpx; }

.theme-name { font-size: 24rpx; color: #5C4A3A; }

.bottom-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A89C8A;
}

/* 弹窗 */
.sheet-title {
  font-size: 32rpx;
  color: #5C4A3A;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.form-label {
  font-size: 24rpx;
  color: #8B7355;
  margin: 22rpx 0 10rpx 4rpx;
}

.input-wrap {
  background-color: #FAF6EE;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
}
.input { flex: 1; font-size: 28rpx; color: #5C4A3A; }

.sheet-actions {
  display: flex;
  margin-top: 36rpx;
}
