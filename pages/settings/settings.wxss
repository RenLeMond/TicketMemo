@import "../../styles/tokens.wxss";

.st-page {
  padding-bottom: 220rpx;
}

.st-hero {
  display: flex;
  align-items: center;
  padding: 10rpx 4rpx 24rpx;
}

.st-cover {
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: var(--tm-shadow-sm);
}

.st-cover-img {
  width: 56rpx;
  height: 56rpx;
}

.st-hero-info {
  min-width: 0;
  flex: 1;
}

.st-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  letter-spacing: 0.02em;
}

.st-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 6rpx;
}

/* 托盘 */
.st-bezel-tray {
  margin-bottom: 28rpx;
}

/* 主题选择卡片 */
.theme-core {
  padding: 22rpx 16rpx;
}

.theme-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.theme-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 10rpx 20rpx;
  border-radius: var(--tm-radius-md);
  background-color: var(--tm-bg-inset);
  border: 2rpx solid transparent;
  transition: all 0.18s var(--tm-spring-bounce);
  cursor: pointer;
}

.theme-cell-active {
  border-color: var(--tm-primary);
  background-color: var(--tm-bg-card);
  box-shadow: var(--tm-shadow-glow);
  transform: scale(1.04);
}

.theme-preview {
  width: 130rpx;
  height: 90rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--tm-shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.theme-light {
  background-color: #FAF6EE;
}
.theme-dot-1 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #8FAE85; }
.theme-dot-2 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #E8A87C; }
.theme-dot-3 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #5C4A3A; }

.theme-green {
  background-color: #F1F8F0;
}
.theme-dot-g1 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #6DA36E; }
.theme-dot-g2 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #4F7E50; }
.theme-dot-g3 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #E5A278; }

.theme-dark {
  background-color: #1C1A18;
}
.theme-dot-d1 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #98B690; }
.theme-dot-d2 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #E5A278; }
.theme-dot-d3 { width: 18rpx; height: 18rpx; border-radius: 50%; background-color: #E8DFD3; }

.theme-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.theme-tag {
  font-size: 18rpx;
  color: var(--tm-primary-deep);
  background: var(--tm-primary-light);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  font-weight: bold;
}

/* 菜单行 */
.menu-bezel-core {
  padding: 6rpx 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  cursor: pointer;
}

.st-menu-ico {
  width: 44rpx;
  height: 44rpx;
}

.menu-text {
  flex: 1;
  margin-left: 20rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
}

.menu-sub {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--tm-text-light);
  font-weight: bold;
}

.menu-divider {
  height: 1rpx;
  background-color: var(--tm-divider);
}

.bottom-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 32rpx;
}
