<view class="page-container st-page has-nav {{themeClass}}">

  <view class="nav-back-bar reveal-1" style="{{navBarInfo ? navBarInfo.navStyle : ''}}">
    <view class="nav-back-btn" bindtap="goBack"></view>
    <view class="nav-page-title font-display">设置与偏好</view>
  </view>
  <view class="nav-back-spacer" style="{{navBarInfo ? navBarInfo.spacerStyle : ''}}"></view>

  <view class="st-hero reveal-1">
    <view class="st-cover icon-circle icon-circle-blue">
      <image class="st-cover-img" src="{{icons.settings}}" mode="aspectFit" />
    </view>
    <view class="st-hero-info">
      <view class="eyebrow-tag">PREFERENCES · 偏好设置</view>
      <view class="st-hero-title font-display">偏好与个性化</view>
      <view class="st-hero-sub">一切都按你最舒服、最安心的方式呈现 🌿</view>
    </view>
  </view>

  <!-- 隐私安全 -->
  <view class="section-title reveal-2">隐私与安全保护</view>
  <view class="bezel-tray st-bezel-tray reveal-2">
    <view class="bezel-core menu-bezel-core">
      <view class="menu-row">
        <view class="icon-circle icon-circle-pink">
          <image class="st-menu-ico" src="{{icons.encrypt}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">启动密码保护</view>
          <view class="menu-sub">{{settings.passwordEnabled ? '已开启 6 位数字密码' : '关闭中'}}</view>
        </view>
        <switch checked="{{settings.passwordEnabled}}" bindchange="onTogglePassword" color="#8FAE85" />
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row" bindtap="onPermissionTip">
        <view class="icon-circle icon-circle-blue">
          <image class="st-menu-ico" src="{{icons.settings}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">权限透明声明</view>
          <view class="menu-sub">仅申请相机/相册/存储，绝无多余授权</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 主题外观选择 -->
  <view class="section-title reveal-3">手账外观主题</view>
  <view class="bezel-tray st-bezel-tray reveal-3">
    <view class="bezel-core theme-core">
      <view class="theme-row">
        <view
          class="theme-cell {{settings.theme === 'light' ? 'theme-cell-active' : ''}}"
          bindtap="onPickTheme"
          data-theme="light"
        >
          <view class="theme-preview theme-light">
            <view class="theme-dot theme-dot-1"></view>
            <view class="theme-dot theme-dot-2"></view>
            <view class="theme-dot theme-dot-3"></view>
          </view>
          <view class="theme-name">米白手账</view>
          <view class="theme-tag" wx:if="{{settings.theme === 'light'}}">当前生效</view>
        </view>

        <view
          class="theme-cell {{settings.theme === 'green' ? 'theme-cell-active' : ''}}"
          bindtap="onPickTheme"
          data-theme="green"
        >
          <view class="theme-preview theme-green">
            <view class="theme-dot theme-dot-g1"></view>
            <view class="theme-dot theme-dot-g2"></view>
            <view class="theme-dot theme-dot-g3"></view>
          </view>
          <view class="theme-name">薄荷小屋</view>
          <view class="theme-tag" wx:if="{{settings.theme === 'green'}}">当前生效</view>
        </view>

        <view
          class="theme-cell {{settings.theme === 'dark' ? 'theme-cell-active' : ''}}"
          bindtap="onPickTheme"
          data-theme="dark"
        >
          <view class="theme-preview theme-dark">
            <view class="theme-dot theme-dot-d1"></view>
            <view class="theme-dot theme-dot-d2"></view>
            <view class="theme-dot theme-dot-d3"></view>
          </view>
          <view class="theme-name">夜读深色</view>
          <view class="theme-tag" wx:if="{{settings.theme === 'dark'}}">当前生效</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 通用设置 -->
  <view class="section-title reveal-4">存储与备份</view>
  <view class="bezel-tray st-bezel-tray reveal-4">
    <view class="bezel-core menu-bezel-core">
      <view class="menu-row">
        <view class="icon-circle icon-circle-green">
          <image class="st-menu-ico" src="{{icons.backup}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">自动本地备份</view>
          <view class="menu-sub">每周在本地自动加密生成快照</view>
        </view>
        <switch checked="{{settings.autoBackup}}" bindchange="onToggleAutoBackup" color="#8FAE85" />
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row">
        <view class="icon-circle icon-circle-orange">
          <image class="st-menu-ico" src="{{icons.filter}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">小票照片智能压缩</view>
          <view class="menu-sub">节省手机本地存储占用</view>
        </view>
        <switch checked="{{settings.compressImage}}" bindchange="onToggleCompress" color="#8FAE85" />
      </view>
    </view>
  </view>

  <!-- 数据维护 -->
  <view class="section-title reveal-4">数据维护</view>
  <view class="bezel-tray st-bezel-tray reveal-4">
    <view class="bezel-core menu-bezel-core">
      <view class="menu-row">
        <view class="icon-circle icon-circle-coffee">
          <image class="st-menu-ico" src="{{icons.calendar}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">最近本地备份时间</view>
          <view class="menu-sub">{{lastBackupAt}}</view>
        </view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row" bindtap="onWipe">
        <view class="icon-circle icon-circle-pink">
          <image class="st-menu-ico" src="{{icons.trash}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title" style="color: var(--tm-accent-deep);">一键清空所有数据并重置</view>
          <view class="menu-sub">不可逆操作，恢复初始化演示数据</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="bottom-tip reveal-4">小票日记 · 纯本地私密小票手账本</view>
</view>

<!-- 设置密码弹窗 -->
<view wx:if="{{showPwdModal}}" class="mask" catchtouchmove="" bindtap="onCancelPassword">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-title">设置启动密码</view>

    <view class="form-label">输入新密码（至少 6 位数字或字符）</view>
    <view class="input-wrap">
      <input class="input" type="password" placeholder="••••••" value="{{pwdInput}}" bindinput="onPwdInput" maxlength="16" />
    </view>

    <view class="form-label" style="margin-top: 20rpx;">请再次确认密码</view>
    <view class="input-wrap">
      <input class="input" type="password" placeholder="••••••" value="{{pwdConfirm}}" bindinput="onPwdConfirm" maxlength="16" />
    </view>

    <view class="sheet-actions">
      <view class="btn btn-ghost flex-1" catchtap="onCancelPassword">取消</view>
      <view class="btn btn-primary flex-1" catchtap="onSavePassword">确认开启</view>
    </view>
  </view>
</view>
