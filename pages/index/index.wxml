<view class="page-container {{themeClass}}">

  <!-- 顶部品牌奢华手账区 -->
  <view class="hero reveal-1">
    <view class="hero-left">
      <view class="eyebrow-tag">HANDCRAFTED JOURNAL · 票忆手账</view>
      <view class="hero-title font-display brand-title">
        <text class="brand-ticket">Ticket</text><text class="brand-memo">Memo</text><text class="brand-dot">.</text>
      </view>
      <view class="hero-sub">{{greeting}}</view>
    </view>
    <view class="hero-mascot">
      <image class="hero-mascot-img" src="{{icons.mascot}}" mode="aspectFit" />
    </view>
  </view>

  <!-- 搜索栏区 -->
  <view class="search-section reveal-2">
    <view class="search">
      <image class="search-icon-img" src="{{icons.search}}" mode="aspectFit" />
      <input
        class="search-input"
        placeholder="搜索商家 / 商品 / 备注"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onInput"
        confirm-type="search"
      />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearKeyword">×</view>
    </view>
  </view>

  <!-- 本月概览卡片（Double-Bezel 双层硬件拟物托盘） -->
  <view class="bezel-tray overview-tray reveal-2">
    <view class="tape tape-left tape-green"></view>
    <view class="tape tape-right tape-pink"></view>

    <view class="bezel-core overview-core">
      <image class="overview-bg-img" src="{{icons.basket}}" mode="aspectFit" />

      <view class="overview-header-row">
        <view class="overview-badge">
          <text class="overview-dot"></text>
          <text>本月小票账目</text>
        </view>
      </view>

      <view class="overview-amount-box">
        <text class="amount-cur font-number">¥</text>
        <text class="amount-val font-number">{{monthTotal}}</text>
      </view>

      <view class="overview-meta-row">
        <view class="overview-meta">已收录 <text class="meta-count font-number">{{monthCount}}</text> 笔生活小确幸</view>
        <view class="overview-date">{{today}}</view>
      </view>

      <!-- Button-in-Button 嵌套岛 CTA 按钮 -->
      <view class="entry-row">
        <view class="btn-nested btn-nested-primary flex-1" bindtap="goAdd" data-mode="camera">
          <text class="btn-nested-text">拍照识别</text>
          <view class="btn-nested-tray">
            <image class="btn-nested-ico" src="{{icons.camera}}" mode="aspectFit" />
          </view>
        </view>

        <view class="btn-nested btn-nested-accent flex-1" bindtap="goAdd" data-mode="album">
          <text class="btn-nested-text">相册导入</text>
          <view class="btn-nested-tray">
            <image class="btn-nested-ico" src="{{icons.album}}" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷分类 (Double-Bezel 双层手账外壳) -->
  <view class="section-title reveal-3">
    快捷分类
    <view class="section-subtitle" bindtap="goCategoryTab">全部分类<text class="section-subtitle-arrow">›</text></view>
  </view>

  <view class="bezel-tray quick-bezel-tray reveal-3">
    <view class="bezel-core quick-bezel-core">
      <view class="quick-cats">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="quick-cat"
          bindtap="goCategory"
          data-id="{{item.id}}"
        >
          <view class="icon-circle icon-circle-{{item.color}}">
            <image wx:if="{{item._iconIsImg}}" class="quick-cat-img" src="{{item.icon}}" mode="aspectFit" />
            <text wx:else class="quick-cat-emoji">{{item.icon}}</text>
          </view>
          <view class="quick-cat-name">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近小票流 -->
  <view class="section-title reveal-4">
    最近小票
    <view class="section-subtitle" bindtap="goCategoryTab">全部<text class="section-subtitle-arrow">›</text></view>
  </view>

  <view class="bezel-tray ledger-tray reveal-4">
    <view class="bezel-core ledger-core">
      <block wx:if="{{filtered.length > 0}}">
        <ticket-card
          wx:for="{{filtered}}"
          wx:key="id"
          receipt="{{item}}"
          variant="ledger"
          isLast="{{index === filtered.length - 1}}"
        />
      </block>

      <empty-state
        wx:else
        iconSrc="{{icons.empty}}"
        text="还没有找到小票呢～"
        sub="试试清除筛选条件，或点底部「+」拍一张吧"
      />
    </view>
  </view>

  <!-- 首页底部暖心寄语 -->
  <view class="bottom-quote reveal-4">一张小票，一段时光；细水长流，皆是生活 🍃</view>

</view>
