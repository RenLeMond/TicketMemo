@import "../../styles/tokens.wxss";

/* 顶部品牌区 */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 4rpx 28rpx;
}

.hero-left {
  flex: 1;
}

.hero-title {
  font-size: 58rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  line-height: 1.1;
  display: flex;
  align-items: baseline;
}

.brand-title {
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.8), 0 2rpx 6rpx rgba(45, 36, 30, 0.05);
}

.brand-ticket {
  color: var(--tm-text-primary);
  font-weight: 800;
  letter-spacing: -0.02em;
}

.brand-memo {
  color: var(--tm-primary-deep);
  font-weight: 700;
  font-style: italic;
  margin-left: 2rpx;
  letter-spacing: -0.01em;
}

.brand-dot {
  color: #B86F65;
  font-weight: 900;
  margin-left: 4rpx;
}

.hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

.hero-mascot {
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--tm-radius-well, 28rpx);
  background-color: var(--tm-bg-inset);
  border: 1rpx solid var(--tm-border-light);
  box-shadow: var(--tm-deboss-well);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.hero-mascot-img {
  width: 76rpx;
  height: 76rpx;
}

/* 搜索区 */
.search-section {
  margin-bottom: 24rpx;
}

.search {
  display: flex;
  align-items: center;
  background-color: var(--tm-bg-card);
  border: 1rpx solid var(--tm-border-light);
  border-radius: var(--tm-radius-pill);
  padding: 18rpx 26rpx;
  box-shadow: var(--tm-shadow-sm);
  transition: all 0.2s var(--tm-spring-ease);
}

.search:focus-within {
  border-color: var(--tm-primary);
  box-shadow: 0 4rpx 16rpx rgba(143, 174, 133, 0.25);
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--tm-text-primary);
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--tm-border);
  color: var(--tm-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
}

/* Double-Bezel 概览卡片 */
.overview-tray {
  margin-bottom: 36rpx;
}

.overview-core {
  padding: 34rpx 30rpx 28rpx;
}

.overview-bg-img {
  position: absolute;
  right: -10rpx;
  bottom: -20rpx;
  width: 190rpx;
  height: 190rpx;
  opacity: 0.08;
  pointer-events: none;
}

.overview-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.overview-badge {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--tm-text-secondary);
}

.overview-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--tm-primary);
  margin-right: 10rpx;
  box-shadow: 0 0 8rpx var(--tm-primary);
}

.overview-amount-box {
  display: flex;
  align-items: baseline;
  margin: 16rpx 0 12rpx;
}

.amount-cur {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  margin-right: 8rpx;
}

.amount-val {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  letter-spacing: -0.03em;
  line-height: 1;
}

.overview-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--tm-text-muted);
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--tm-dotted-line);
}

.meta-count {
  color: var(--tm-text-primary);
  font-weight: 700;
}

/* 嵌套岛 CTA 按钮行 */
.entry-row {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.btn-nested-text {
  font-size: 28rpx;
  letter-spacing: 0.02em;
}

/* 快捷分类 (Double-Bezel 双层手账托盘) */
.quick-bezel-tray {
  margin-bottom: 24rpx;
}

.quick-bezel-core {
  padding: 24rpx 14rpx 20rpx;
}

.quick-cats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx 10rpx;
}

.quick-cat {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
  cursor: pointer;
  border-radius: var(--tm-radius-sm);
  transition: transform 0.18s var(--tm-spring-bounce);
}

.quick-cat:active {
  transform: scale(0.94);
}

.quick-cat-img {
  width: 48rpx;
  height: 48rpx;
}

.quick-cat-emoji {
  font-size: 38rpx;
}

.quick-cat-name {
  font-size: 22rpx;
  color: var(--tm-text-primary);
  margin-top: 10rpx;
  font-weight: 600;
  line-height: 1;
}
