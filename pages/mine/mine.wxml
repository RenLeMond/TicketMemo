<view class="page-container mine-page {{themeClass}}">

  <!-- 个人中心手账卡片（Double-Bezel 双层硬件托盘） -->
  <view class="bezel-tray me-bezel-tray reveal-1">
    <view class="tape tape-left tape-green"></view>
    <view class="tape tape-right tape-pink"></view>

    <view class="bezel-core me-core-card">
      <view class="eyebrow-tag">PERSONAL ARCHIVE · 个人归档</view>
      <view class="me-header">
        <view class="me-mascot-box">
          <image class="me-mascot-img" src="{{icons.mascot}}" mode="aspectFit" />
        </view>
        <view class="me-info">
          <view class="me-title font-display">小票日记 · 手账本</view>
          <view class="me-sub">每一张小票，都是生活的温柔痕迹 🌿</view>
        </view>
      </view>

      <view class="me-stats-row">
        <view class="me-stat-item">
          <view class="me-stat-val font-number">{{receiptCount}}</view>
          <view class="me-stat-lbl">小票总数</view>
        </view>
        <view class="me-stat-divider"></view>
        <view class="me-stat-item">
          <view class="me-stat-val font-number">{{eventCount}}</view>
          <view class="me-stat-lbl">事件故事</view>
        </view>
        <view class="me-stat-divider"></view>
        <view class="me-stat-item">
          <view class="me-stat-val font-number">¥{{totalExpense}}</view>
          <view class="me-stat-lbl">累计入账</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 隐私安全保护状态卡片 -->
  <view class="safe-card reveal-2" bindtap="onPrivacy">
    <view class="icon-circle icon-circle-green safe-icon">
      <image class="mine-menu-ico" src="{{icons.encrypt}}" mode="aspectFit" />
    </view>
    <view class="safe-text">
      <view class="safe-title">100% 纯本地离线隐私保护中</view>
      <view class="safe-sub">无社交、无第三方上传、仅存设备本地</view>
    </view>
    <view class="safe-arrow">›</view>
  </view>

  <!-- 核心数据与管理操作 -->
  <view class="section-title reveal-3">数据与归档</view>
  <view class="bezel-tray menu-bezel-tray reveal-3">
    <view class="bezel-core menu-bezel-core">
      <view class="menu-row" bindtap="goExport">
        <view class="icon-circle icon-circle-orange">
          <image class="mine-menu-ico" src="{{icons.export}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">台账导出与备份</view>
          <view class="menu-sub">Excel CSV / PDF 报销台账 / JSON</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row" bindtap="goTrash">
        <view class="icon-circle icon-circle-pink">
          <image class="mine-menu-ico" src="{{icons.trash}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">小票回收站</view>
          <view class="menu-sub">{{trashCount > 0 ? (trashCount + ' 项可恢复小票') : '暂无已删除小票'}}</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 偏好与隐私设置 -->
  <view class="section-title reveal-4">安全与偏好</view>
  <view class="bezel-tray menu-bezel-tray reveal-4">
    <view class="bezel-core menu-bezel-core">
      <view class="menu-row" bindtap="goSettings">
        <view class="icon-circle icon-circle-coffee">
          <image class="mine-menu-ico" src="{{icons.encrypt}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">启动密码锁屏</view>
          <view class="menu-sub">{{settings.passwordEnabled ? '已开启 6 位密码保护' : '未开启'}}</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row" bindtap="goSettings">
        <view class="icon-circle icon-circle-blue">
          <image class="mine-menu-ico" src="{{icons.settings}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">主题外观与偏好</view>
          <view class="menu-sub">米白手账 / 薄荷小屋 / 夜读模式</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 关于与协议 -->
  <view class="section-title reveal-4">关于与帮助</view>
  <view class="bezel-tray menu-bezel-tray reveal-4">
    <view class="bezel-core menu-bezel-core">
      <view class="menu-row" bindtap="onPrivacy">
        <view class="icon-circle icon-circle-yellow">
          <image class="mine-menu-ico" src="{{icons.pdf}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">隐私政策与合规承诺</view>
          <view class="menu-sub">纯本地工具，无信息外泄风险</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-row" bindtap="onAbout">
        <view class="icon-circle icon-circle-pink">
          <image class="mine-menu-ico" src="{{icons.favorite}}" mode="aspectFit" />
        </view>
        <view class="menu-text">
          <view class="menu-title">关于小票日记</view>
          <view class="menu-sub">v1.2.0 (手账重构版)</view>
        </view>
        <view class="menu-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="bottom-quote">愿你记录的每一笔开销，都化作平淡生活里的小确幸 🌿</view>
</view>

<!-- 回收站管理弹窗 -->
<view wx:if="{{showTrashModal}}" class="mask" catchtouchmove="">
  <view class="sheet trash-sheet" catchtap="">
    <view class="sheet-handle"></view>
    <view class="trash-header">
      <view class="sheet-title" style="margin: 0;">小票回收站 ({{trashCount}})</view>
      <view class="trash-clear-btn" bindtap="onClearAllTrash">清空回收站</view>
    </view>
    <view class="trash-tip">已删除的小票将保留在回收站中，可随时一键恢复</view>

    <scroll-view class="trash-scroll" scroll-y>
      <view wx:for="{{trashList}}" wx:key="id" class="trash-item">
        <view class="icon-circle icon-circle-{{item.color || 'coffee'}} trash-thumb">
          <image class="trash-thumb-img" src="{{item._thumb}}" mode="aspectFit" />
        </view>
        <view class="trash-info">
          <view class="trash-merchant">{{item.merchant}}</view>
          <view class="trash-meta">{{item._dateText}} · {{item._amountText}}</view>
        </view>
        <view class="trash-actions">
          <view class="trash-btn-restore" bindtap="onRestoreItem" data-id="{{item.id}}">恢复</view>
          <view class="trash-btn-delete" bindtap="onDeleteForever" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </scroll-view>

    <view class="sheet-actions">
      <view class="btn btn-ghost flex-1" bindtap="onCloseTrash">关闭</view>
      <view class="btn btn-primary flex-1" bindtap="onRestoreAllTrash">全部恢复</view>
    </view>
  </view>
</view>

<!-- 我的页面通用手账确认与信息弹窗 (Double-Bezel Confirm Dialog) -->
<view wx:if="{{showConfirmDialog}}" class="dialog-mask" catchtouchmove="" bindtap="onDialogCancel">
  <view class="dialog-box" catchtap="">
    <view class="bezel-tray">
      <view class="tape tape-center {{confirmDialog.isDanger ? 'tape-pink' : 'tape-green'}}"></view>
      <view class="bezel-core dialog-core">
        <view class="dialog-title font-display">{{confirmDialog.title}}</view>
        <view class="dialog-desc" style="white-space: pre-line; text-align: {{confirmDialog.isInfoOnly ? 'left' : 'center'}};">{{confirmDialog.desc}}</view>
        <view class="sheet-actions">
          <view wx:if="{{!confirmDialog.isInfoOnly}}" class="btn btn-ghost flex-1" bindtap="onDialogCancel">取消</view>
          <view class="btn {{confirmDialog.isDanger ? 'btn-danger' : 'btn-primary'}} flex-1" bindtap="onDialogConfirm">
            {{confirmDialog.isInfoOnly ? '我知道了' : (confirmDialog.isDanger ? '确认删除' : '确定')}}
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
