<view class="page-container ec-page">

  <view class="ec-hero">
    <view class="ec-cover icon-circle-{{coverColor}}">
      <image class="ec-cover-img" src="{{cover}}" mode="aspectFit" />
    </view>
    <view class="ec-hero-title">{{isEdit ? '编辑事件' : '新建事件'}}</view>
    <view class="ec-hero-sub">把这段日子里的小票串起来</view>
  </view>

  <view class="card ec-form">
    <view class="form-group">
      <view class="form-label">事件名称</view>
      <view class="input-wrap">
        <input
          class="input"
          placeholder="例如 杭州两日游 / 月度日常"
          placeholder-class="input-placeholder"
          value="{{name}}"
          bindinput="onNameInput"
          maxlength="20"
        />
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">事件时间</view>
      <view class="date-row">
        <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
          <view class="input-wrap">
            <text class="input">{{startDate}}</text>
          </view>
        </picker>
        <view class="date-tilde">～</view>
        <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
          <view class="input-wrap">
            <text class="input">{{endDate}}</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">事件备注</view>
      <view class="textarea-wrap">
        <textarea
          class="textarea"
          placeholder="写一句这段日子的心情吧～"
          placeholder-style="color:#C9BDA8;"
          value="{{note}}"
          bindinput="onNoteInput"
          maxlength="80"
        ></textarea>
      </view>
    </view>

    <view class="form-group">
      <view class="form-label">事件封面</view>
      <view class="cover-grid">
        <view
          wx:for="{{coverOptions}}"
          wx:key="src"
          class="cover-cell icon-circle-{{item.color}} {{cover === item.src ? 'cover-cell-active' : ''}}"
          bindtap="onPickCover"
          data-idx="{{index}}"
        >
          <image class="cover-cell-img" src="{{item.src}}" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <view class="section-title">
    选择小票
    <text class="section-subtitle">已选 {{selectedIds.length}} 张</text>
  </view>

  <view class="card receipt-list" wx:if="{{receipts.length > 0}}">
    <view
      wx:for="{{receipts}}"
      wx:key="id"
      class="rec-row {{selectedIds.indexOf(item.id) >= 0 ? 'rec-row-active' : ''}}"
      bindtap="onToggleReceipt"
      data-id="{{item.id}}"
    >
      <view class="rec-check">{{selectedIds.indexOf(item.id) >= 0 ? '✓' : ''}}</view>
      <view class="icon-circle icon-circle-{{item.color || 'coffee'}}">
        <image class="rec-thumb" src="{{item._thumb}}" mode="aspectFit" />
      </view>
      <view class="rec-body">
        <view class="rec-merchant">{{item.merchant}}</view>
        <view class="rec-meta">{{item.items}}</view>
      </view>
      <view class="rec-amount">¥{{item.amount.toFixed(2)}}</view>
    </view>
  </view>
  <empty-state wx:else iconSrc="/assets/icons/tab/home@3x.png" text="还没有小票可以选择" sub="先到首页录入几张吧" />

  <view class="action-bar">
    <view class="btn btn-ghost flex-1 mr-8" bindtap="onCancel">取消</view>
    <view class="btn btn-primary flex-1" bindtap="onSave">{{isEdit ? '保存修改' : '创建事件'}}</view>
  </view>
</view>
