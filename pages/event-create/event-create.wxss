@import "../../styles/tokens.wxss";

.ec-page {
  padding-bottom: 200rpx;
}

.ec-hero {
  display: flex;
  align-items: center;
  padding: 10rpx 4rpx 24rpx;
}

.ec-cover {
  width: 110rpx;
  height: 110rpx;
  border-radius: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: var(--tm-shadow-sm);
}

.ec-cover-img {
  width: 88rpx;
  height: 88rpx;
}

.ec-hero-info {
  min-width: 0;
  flex: 1;
}

.ec-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ec-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 6rpx;
}

/* 托盘 */
.ec-bezel-tray {
  margin-bottom: 28rpx;
}

.ec-core-form {
  padding: 26rpx 22rpx;
}

.ec-core-list {
  padding: 14rpx 16rpx;
}

.form-group {
  margin-bottom: 22rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
  margin-bottom: 12rpx;
}

.date-row {
  display: flex;
  align-items: center;
}

.date-picker-flex {
  flex: 1;
}

.date-tilde {
  margin: 0 16rpx;
  color: var(--tm-text-muted);
  font-weight: bold;
}

/* 封面选择网格 */
.cover-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.cover-cell {
  width: 100%;
  height: 120rpx;
  border-radius: var(--tm-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.18s var(--tm-spring-bounce);
}

.cover-cell-active {
  border-color: var(--tm-primary);
  transform: scale(1.06);
  box-shadow: var(--tm-shadow-glow);
}

.cover-cell-img {
  width: 90rpx;
  height: 90rpx;
}

/* 小票多选列表 */
.rec-row {
  display: flex;
  align-items: center;
  padding: 18rpx 12rpx;
  border-radius: var(--tm-radius-sm);
  border-bottom: 1rpx solid var(--tm-divider);
  transition: background-color 0.15s ease;
}

.rec-row:last-child {
  border-bottom: none;
}

.rec-row-active {
  background-color: var(--tm-bg-inset);
}

.rec-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--tm-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: var(--tm-bg-card);
  transition: all 0.18s var(--tm-spring-bounce);
  flex-shrink: 0;
}

.rec-check-active {
  background: var(--tm-primary);
  border-color: var(--tm-primary);
  box-shadow: 0 2rpx 8rpx rgba(143, 174, 133, 0.4);
}

.rec-thumb-wrap {
  width: 68rpx;
  height: 68rpx;
  margin-right: 16rpx;
}

.rec-thumb {
  width: 42rpx;
  height: 42rpx;
}

.rec-body {
  flex: 1;
  min-width: 0;
}

.rec-merchant {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rec-meta {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rec-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tm-accent-deep);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 底部操作按钮栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(24rpx + env(safe-area-inset-bottom, 24px));
  background: var(--tm-tab-bg);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border-top: 1rpx solid var(--tm-tab-border);
  display: flex;
  z-index: 100;
}
