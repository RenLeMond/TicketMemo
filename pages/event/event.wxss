.ev-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx 18rpx;
}
.ev-hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #5C4A3A;
}
.ev-hero-sub {
  font-size: 24rpx;
  color: #A89C8A;
  margin-top: 6rpx;
}

.ev-add {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #F2B68B 0%, #E8A87C 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  box-shadow: 0 4rpx 14rpx rgba(232, 168, 124, 0.35);
}
.ev-add-plus { font-size: 32rpx; margin-right: 8rpx; }

.ev-list {
  padding: 6rpx 0 8rpx;
}

.ev-card {
  display: flex;
  align-items: center;
  min-height: 210rpx;
  padding: 28rpx 24rpx 24rpx 28rpx;
  margin-bottom: 22rpx;
  border-radius: 26rpx;
  background:
    linear-gradient(180deg, rgba(255, 252, 247, 0.96) 0%, rgba(250, 246, 238, 0.98) 100%),
    #FFFCF7;
  border: 1rpx solid rgba(232, 223, 201, 0.6);
  box-shadow: 0 4rpx 18rpx rgba(184, 153, 104, 0.08);
  position: relative;
  overflow: visible;
}

.ev-card-active {
  border-color: #8FAE85;
  box-shadow: 0 6rpx 22rpx rgba(143, 174, 133, 0.22);
  background: linear-gradient(180deg, #FFFCF7 0%, #F4F8EA 100%);
}

.ev-card::before {
  content: "";
  position: absolute;
  top: -12rpx;
  left: 58rpx;
  width: 120rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: rgba(235, 223, 200, 0.8);
  border: 1rpx solid rgba(184, 153, 104, 0.18);
  transform: rotate(-2deg);
}

.ev-card-main {
  flex: 1;
  min-width: 0;
}

.ev-polaroid {
  width: 156rpx;
  height: 130rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  background-color: #fffaf1;
  border: 8rpx solid #fffcf7;
  box-shadow: 0 6rpx 14rpx rgba(92, 74, 58, 0.08);
  transform: rotate(2deg);
}
.ev-cover-img {
  width: 112rpx;
  height: 112rpx;
}

.ev-card-name {
  font-size: 32rpx;
  color: #5C4A3A;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ev-card-date {
  font-size: 22rpx;
  color: #A89C8A;
  margin-top: 10rpx;
}

.ev-card-total {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #C97B47;
  font-weight: 600;
}

.ev-card-count {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8B7355;
}

/* 事件明细 */
.ev-detail { margin-top: 28rpx; }

.ev-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 18rpx 0;
}

.ev-anim-btn {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background-color: #DCE9D1;
  color: #6B8C5E;
  font-size: 24rpx;
}
.ev-anim-icon { margin-right: 8rpx; }

.ev-summary {
  display: flex;
  align-items: center;
  background-color: #FFFCF7;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(184, 153, 104, 0.06);
  border: 1rpx solid rgba(232, 223, 201, 0.5);
}
.ev-summary-item { flex: 1; text-align: center; }
.ev-summary-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #EFE6D1;
}
.ev-summary-label { font-size: 22rpx; color: #A89C8A; }
.ev-summary-value {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #5C4A3A;
}
