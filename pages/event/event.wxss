@import "../../styles/tokens.wxss";

.event-page {
  padding-bottom: 220rpx;
}

/* 顶部标题区（防胶囊遮挡） */
.event-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 10rpx 4rpx 20rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.event-hero-left {
  flex: 1;
  min-width: 360rpx;
}

.event-hero-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.event-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

.event-create-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--tm-primary) 0%, var(--tm-primary-deep) 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(101, 133, 87, 0.25);
  cursor: pointer;
  transition: transform 0.18s var(--tm-spring-bounce);
  margin-bottom: 4rpx;
  box-sizing: border-box;
}

.event-create-plus {
  font-size: 32rpx;
  line-height: 1;
  font-weight: bold;
}

/* 事件卡片列表 */
.event-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 10rpx;
}

.event-bezel-card {
  padding: 6rpx;
  transition: transform 0.22s var(--tm-spring-ease), box-shadow 0.22s ease;
}

.event-card-tilt {
  transform: rotate(-0.6deg);
}

.event-card-tilt-alt {
  transform: rotate(0.6deg);
}

.event-core-card {
  padding: 28rpx 26rpx 22rpx;
}

.event-polaroid-head {
  display: flex;
  align-items: center;
}

.event-cover-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--tm-radius-well, 24rpx);
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: var(--tm-bg-inset);
  border: 1rpx solid var(--tm-border-light);
  box-shadow: var(--tm-deboss-well);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.event-cover-img {
  width: 68rpx;
  height: 68rpx;
}

.event-head-info {
  flex: 1;
  min-width: 0;
}

.event-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.event-date {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
}

.event-count-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.event-note-quote {
  font-size: 24rpx;
  color: var(--tm-text-secondary);
  font-style: italic;
  background-color: var(--tm-bg-inset);
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  margin-top: 18rpx;
  line-height: 1.45;
  border: 1rpx solid var(--tm-border-light);
}

.event-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.event-total-box {
  display: flex;
  flex-direction: column;
}

.event-total-label {
  font-size: 20rpx;
  color: var(--tm-text-muted);
  font-weight: 600;
  letter-spacing: 0.05em;
}

.event-total-amount {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  letter-spacing: -0.01em;
}

.event-quick-actions {
  display: flex;
  gap: 12rpx;
}

.event-quick-actions .btn-nested {
  height: 72rpx;
  padding: 0 12rpx 0 24rpx;
}

.event-quick-actions .btn-nested-tray {
  width: 48rpx;
  height: 48rpx;
  margin-left: 10rpx;
  border-radius: var(--tm-radius-well, 14rpx);
}

.event-quick-actions .btn-nested-ico {
  width: 28rpx;
  height: 28rpx;
}

.event-btn-text {
  font-size: 24rpx;
}

/* 翻页画册弹窗 */
.flip-modal {
  width: 640rpx;
  background-color: var(--tm-bg-page);
  border-radius: 36rpx;
  padding: 30rpx 24rpx 40rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.35);
  margin: auto;
  align-self: center;
}

.flip-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 20rpx;
}

.flip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
}

.flip-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--tm-border);
  color: var(--tm-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: bold;
}

.flip-swiper {
  width: 100%;
  height: 720rpx;
}

.flip-page-card {
  position: relative;
  width: 560rpx;
  height: 640rpx;
  background-color: var(--tm-bg-card);
  border-radius: 28rpx;
  margin: 10rpx auto 0;
  padding: 36rpx 28rpx 24rpx;
  box-shadow: var(--tm-shadow-card);
  border: 1rpx solid var(--tm-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: hidden;
}

.flip-merchant {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
  margin-top: 10rpx;
}

.flip-date {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 4rpx;
}

.flip-img-wrap {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin: 18rpx 0;
}

.flip-img {
  width: 100%;
  height: 100%;
}

.flip-placeholder-wrap {
  width: 130rpx;
  height: 130rpx;
  border-radius: var(--tm-radius-well, 34rpx);
  margin: 40rpx 0;
  overflow: hidden;
  box-sizing: border-box;
}

.flip-placeholder-img {
  width: 78rpx;
  height: 78rpx;
}

.flip-amount {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
}

.flip-note {
  font-size: 22rpx;
  color: var(--tm-text-secondary);
  font-style: italic;
  margin-top: 8rpx;
  max-width: 90%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.flip-index-badge {
  margin-top: auto;
  font-size: 20rpx;
  color: var(--tm-text-light);
}

/* 隐藏渲染画布 */
.hidden-poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 375px;
  height: 600px;
}
