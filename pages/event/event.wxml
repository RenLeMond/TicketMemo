<view class="page-container event-page {{themeClass}}">

  <!-- 顶部标题区（避开微信右上角胶囊） -->
  <view class="event-hero reveal-1">
    <view class="event-hero-left">
      <view class="eyebrow-tag">STORY SCRAPBOOK · 故事集</view>
      <view class="event-hero-title font-display">事件故事手账</view>
      <view class="event-hero-sub">将散落的小票，串联成闪闪发光的独家记忆 🌿</view>
    </view>
    <view class="event-create-pill" bindtap="goCreate">
      <text class="event-create-plus">+</text>
      <text>新建故事</text>
    </view>
  </view>

  <!-- 事件卡片列表 -->
  <view class="event-list reveal-2" wx:if="{{eventList.length > 0}}">
    <view
      wx:for="{{eventList}}"
      wx:key="id"
      class="bezel-tray event-bezel-card {{index % 2 === 1 ? 'event-card-tilt-alt' : 'event-card-tilt'}}"
      bindtap="onOpenActionSheet"
      data-id="{{item.id}}"
    >
      <view class="tape tape-left {{index % 2 === 0 ? 'tape-green' : 'tape-pink'}}"></view>

      <view class="bezel-core event-core-card">
        <view class="event-polaroid-head">
          <view class="icon-circle icon-circle-{{item.coverColor || 'green'}} event-cover-wrap">
            <image class="event-cover-img" src="{{item.coverSrc}}" mode="aspectFit" />
          </view>
          <view class="event-head-info">
            <view class="event-name">{{item.name}}</view>
            <view class="event-date font-number">{{item.dateRangeText}}</view>
          </view>
          <view class="event-count-badge tag tag-green">{{item.count}} 张小票</view>
        </view>

        <view class="event-note-quote" wx:if="{{item.note}}">
          “{{item.note}}”
        </view>

        <view class="dotted-divider"></view>

        <view class="event-card-footer">
          <view class="event-total-box">
            <text class="event-total-label">故事总计</text>
            <text class="event-total-amount font-number">{{item.totalAmount}}</text>
          </view>

          <!-- 嵌套岛按钮操作 -->
          <view class="event-quick-actions">
            <view class="btn-nested btn-nested-primary" catchtap="onOpenFlipModal" data-id="{{item.id}}">
              <text class="event-btn-text">画册</text>
              <view class="btn-nested-tray">
                <image class="btn-nested-ico" src="{{icons.book}}" mode="aspectFit" />
              </view>
            </view>
            <view class="btn-nested btn-nested-accent" catchtap="onGeneratePoster" data-id="{{item.id}}">
              <text class="event-btn-text">海报</text>
              <view class="btn-nested-tray">
                <image class="btn-nested-ico" src="{{icons.share}}" mode="aspectFit" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <empty-state
    wx:else
    iconSrc="{{icons.empty}}"
    text="还没有创建任何事件故事呢"
    sub="点击上方「+ 新建故事」，把一次旅行或聚餐串成手账吧"
  />

  <!-- 事件页底部暖心寄语 -->
  <view class="bottom-quote reveal-4">每一本事件手账，都锁着一段值得重温的故事 🌱</view>
</view>

<!-- 手账画册翻页浏览弹窗 (Swiper Flip-book Mode) -->
<view wx:if="{{showFlipModal}}" class="mask" catchtouchmove="" bindtap="onCloseFlipModal">
  <view class="flip-modal" catchtap="">
    <view class="flip-header">
      <view class="flip-title font-display">{{activeFlipEvent.name}} · 手账画册</view>
      <view class="flip-close" bindtap="onCloseFlipModal">×</view>
    </view>

    <swiper
      class="flip-swiper"
      indicator-dots="{{true}}"
      indicator-color="rgba(143, 174, 133, 0.3)"
      indicator-active-color="#8FAE85"
      current="{{currentFlipIndex}}"
      bindchange="onFlipSwiperChange"
    >
      <swiper-item wx:for="{{flipReceipts}}" wx:key="id">
        <view class="flip-page-card">
          <view class="tape tape-center tape-green"></view>
          <view class="flip-merchant">{{item.merchant}}</view>
          <view class="flip-date font-number">{{item._dateText}}</view>

          <view wx:if="{{item.image}}" class="flip-img-wrap">
            <image class="flip-img" src="{{item.image}}" mode="aspectFill"></image>
          </view>
          <view wx:else class="flip-placeholder-wrap icon-circle icon-circle-{{item.color || 'coffee'}}">
            <image class="flip-placeholder-img" src="{{item._thumb}}" mode="aspectFit" />
          </view>

          <view class="flip-amount font-number">¥{{item.amount.toFixed(2)}}</view>
          <view class="flip-note" wx:if="{{item.note}}">“{{item.note}}”</view>
          <view class="flip-index-badge">第 {{index + 1}} / {{flipReceipts.length}} 页</view>
        </view>
      </swiper-item>
    </swiper>
  </view>
</view>

<!-- 事件管理手账抽屉 (Custom Handcrafted Action Sheet) -->
<view wx:if="{{showActionDrawer}}" class="mask" catchtouchmove="" bindtap="onCloseActionDrawer">
  <view class="custom-sheet" catchtap="">
    <view class="sheet-handle"></view>
    <view class="custom-sheet-header">
      <view class="sheet-title font-display" style="margin-bottom: 6rpx;">{{actionEvent.name}} · 故事管理</view>
      <view class="sheet-item-sub">{{actionEvent.count}} 张小票 · 共计 ¥{{actionEvent.totalAmount}}</view>
    </view>

    <view class="sheet-item-row" bindtap="onDrawerFlip">
      <view class="icon-circle icon-circle-green sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.book}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">翻页画册浏览</view>
        <view class="sheet-item-sub">像翻看实体手账画册一样重温小票</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-item-row" bindtap="onDrawerPoster">
      <view class="icon-circle icon-circle-orange sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.share}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">生成手账海报</view>
        <view class="sheet-item-sub">绘制专属复古小票长图，分享朋友圈</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-item-row" bindtap="onDrawerEdit">
      <view class="icon-circle icon-circle-coffee sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.edit}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">编辑事件故事</view>
        <view class="sheet-item-sub">修改故事标题、封面与备注</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-item-row" bindtap="onDrawerExport">
      <view class="icon-circle icon-circle-blue sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.export}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">导出事件台账</view>
        <view class="sheet-item-sub">导出 Excel / PDF 报销台账明细</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-item-row sheet-item-danger" bindtap="onDrawerDelete">
      <view class="icon-circle icon-circle-pink sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.delete}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">删除事件故事</view>
        <view class="sheet-item-sub">仅解除事件关联，小票依然完好保留</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-actions" style="margin-top: 24rpx;">
      <view class="btn btn-ghost btn-block" bindtap="onCloseActionDrawer">取消</view>
    </view>
  </view>
</view>

<!-- 删除事件确认弹窗 (Double-Bezel Confirm Dialog) -->
<view wx:if="{{showDeleteConfirm}}" class="dialog-mask" catchtouchmove="" bindtap="onCancelDeleteConfirm">
  <view class="dialog-box" catchtap="">
    <view class="bezel-tray">
      <view class="tape tape-center tape-pink"></view>
      <view class="bezel-core dialog-core">
        <view class="dialog-title font-display">删除故事</view>
        <view class="dialog-desc">确定删除事件「{{actionEvent.name}}」吗？\n事件下所有小票不会被删除，仅取消事件归类。</view>
        <view class="sheet-actions">
          <view class="btn btn-ghost flex-1" bindtap="onCancelDeleteConfirm">取消</view>
          <view class="btn btn-danger flex-1" bindtap="onConfirmDeleteEvent">确认删除</view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 隐藏/渲染用 Canvas 2D 用于生成手账海报 -->
<canvas type="2d" id="posterCanvas" class="hidden-poster-canvas"></canvas>
