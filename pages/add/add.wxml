<view class="page-container add-page has-nav {{themeClass}}">

  <view class="nav-back-bar reveal-1" style="{{navBarInfo ? navBarInfo.navStyle : ''}}">
    <view class="nav-back-btn" bindtap="onCancel"></view>
    <view class="nav-page-title font-display">{{isEdit ? '编辑小票' : '录入新小票'}}</view>
  </view>
  <view class="nav-back-spacer" style="{{navBarInfo ? navBarInfo.spacerStyle : ''}}"></view>

  <!-- 步骤 1：选择来源 -->
  <block wx:if="{{step === 'pick'}}">
    <view class="add-hero reveal-1">
      <view class="eyebrow-tag">NEW MEMORY · 新账入册</view>
      <view class="add-hero-mascot">
        <image class="add-hero-img" src="{{icons.camera}}" mode="aspectFit" />
      </view>
      <view class="add-hero-title font-display">轻贴一张新小票</view>
      <view class="add-hero-sub">记录一次消费，留下当日温度 🌿</view>
    </view>

    <view class="pick-row reveal-2">
      <view class="bezel-tray pick-bezel-tray" bindtap="onPickCamera">
        <view class="tape tape-left tape-green"></view>
        <view class="bezel-core pick-core">
          <view class="icon-circle icon-circle-green pick-ico-wrap">
            <image class="pick-ico" src="{{icons.camera}}" mode="aspectFit" />
          </view>
          <view class="pick-title">拍照录入</view>
          <view class="pick-sub">相机拍摄 · 自动提取</view>
        </view>
      </view>

      <view class="bezel-tray pick-bezel-tray" bindtap="onPickAlbum">
        <view class="tape tape-right tape-pink"></view>
        <view class="bezel-core pick-core">
          <view class="icon-circle icon-circle-orange pick-ico-wrap">
            <image class="pick-ico" src="{{icons.album}}" mode="aspectFit" />
          </view>
          <view class="pick-title">相册导入</view>
          <view class="pick-sub">选取截图或发票照片</view>
        </view>
      </view>
    </view>

    <view class="pick-skip-wrap reveal-3">
      <view class="pick-skip" bindtap="onSkip">
        <image class="skip-icon" src="{{icons.edit}}" mode="aspectFit" />
        <text class="skip-text">跳过选图，直接手动录入详情</text>
        <text class="skip-arrow">›</text>
      </view>
    </view>
  </block>

  <!-- 步骤 2：OCR 智能扫描中 -->
  <block wx:elif="{{step === 'scan'}}">
    <view class="scan-container reveal-1">
      <view class="scan-img-wrap">
        <image wx:if="{{image}}" class="scan-img" src="{{image}}" mode="aspectFit"></image>
        <image wx:else class="scan-placeholder-img" src="{{icons.tag}}" mode="aspectFit" />
        <!-- 动态扫描激光线 -->
        <view class="scan-laser"></view>
      </view>

      <view class="bezel-tray scan-status-tray">
        <view class="bezel-core scan-status-core">
          <view class="scan-spin-box">
            <image class="scan-spin-img" src="{{icons.search}}" mode="aspectFit" />
          </view>
          <view class="scan-title">本地 OCR 识别分析中…</view>
          <view class="scan-tip">100% 手机本地离线运算，不会上传任何图片</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 步骤 3：手账编辑与入账 -->
  <block wx:elif="{{step === 'edit'}}">
    <!-- 防重智能提示气泡 -->
    <view wx:if="{{duplicateWarning}}" class="duplicate-banner reveal-1">
      <text class="duplicate-icon">⚠️</text>
      <text class="duplicate-text">{{duplicateWarning}}</text>
    </view>

    <!-- 顶部预览：原图 / 彩色占位图标 -->
    <view class="edit-preview reveal-1">
      <view wx:if="{{image}}" class="edit-img-wrap" bindtap="onChangeImage">
        <view class="tape tape-left tape-green"></view>
        <image class="edit-img" src="{{image}}" mode="aspectFill"></image>
        <view class="edit-img-overlay">点击更换 / 重新拍照 📷</view>
      </view>
      <view wx:else class="bezel-tray edit-placeholder-tray">
        <view class="bezel-core edit-placeholder-core">
          <view class="icon-circle icon-circle-{{displayPlaceholderColor}} edit-placeholder-icon" bindtap="onChangeImage">
            <image class="edit-ph-img" src="{{displayPlaceholder}}" mode="aspectFit" />
          </view>
          <view class="edit-placeholder-tip">
            未选照片，可挑新手账图标或 <text class="edit-upload-btn" bindtap="onChangeImage">拍照/相册导入 📷</text>
          </view>
          <view class="edit-placeholder-options">
            <view
              wx:for="{{placeholderOptions}}"
              wx:key="src"
              class="placeholder-cell icon-circle-{{item.color}} {{placeholderCustomized && placeholder === item.src ? 'placeholder-cell-active' : ''}}"
              bindtap="onPickPlaceholder"
              data-idx="{{index}}"
            >
              <image class="ph-opt-img" src="{{item.src}}" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 小票表单卡片（Double-Bezel 托盘） -->
    <view class="bezel-tray edit-bezel-tray reveal-2">
      <view class="bezel-core edit-bezel-core">
        <view class="form-group">
          <view class="form-label">消费商家 / 场所</view>
          <view class="input-wrap">
            <input
              class="input"
              placeholder="例如 Starbucks 星巴克、盒马鲜生"
              placeholder-class="input-placeholder"
              value="{{merchant}}"
              bindinput="onMerchantInput"
            />
          </view>
        </view>

        <view class="form-group">
          <view class="form-label">小票金额</view>
          <view class="input-wrap amount-input-wrap">
            <text class="amount-prefix font-number">¥</text>
            <input
              class="input amount-input font-number"
              type="digit"
              placeholder="0.00"
              placeholder-class="input-placeholder"
              value="{{amount}}"
              bindinput="onAmountInput"
            />
          </view>
        </view>

        <view class="form-group">
          <view class="form-label">消费日期</view>
          <picker mode="date" value="{{dateText}}" bindchange="onDateChange">
            <view class="input-wrap flex-between">
              <view class="flex flex-center">
                <image class="form-ico" src="{{icons.calendar}}" mode="aspectFit" />
                <text class="input font-number">{{dateText || '点击选择日期'}}</text>
              </view>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
        </view>

        <view class="form-group">
          <view class="form-label">商品摘要</view>
          <view class="input-wrap">
            <input
              class="input"
              placeholder="例如 燕麦拿铁 *1、手账胶带 *2"
              placeholder-class="input-placeholder"
              value="{{items}}"
              bindinput="onItemsInput"
            />
          </view>
        </view>

        <view class="form-group">
          <view class="form-label">手账随笔 / 心情备注</view>
          <view class="textarea-wrap">
            <textarea
              class="textarea"
              placeholder="写下关于这张小票的温柔回忆吧～"
              placeholder-style="color: var(--tm-text-light);"
              value="{{note}}"
              bindinput="onNoteInput"
              maxlength="100"
            ></textarea>
          </view>
        </view>
      </view>
    </view>

    <!-- 分类归属 -->
    <view class="section-title reveal-3">分类归属</view>
    <view class="bezel-tray edit-bezel-tray reveal-3">
      <view class="bezel-core edit-bezel-core">
        <view class="cat-grid">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="cat-pick {{categoryId === item.id ? 'cat-pick-active' : ''}}"
            bindtap="onPickCategory"
            data-id="{{item.id}}"
          >
            <view class="icon-circle icon-circle-{{item.color}}">
              <image wx:if="{{item._iconIsImg}}" class="cat-pick-img" src="{{item.icon}}" mode="aspectFit" />
              <text wx:else class="cat-pick-emoji">{{item.icon}}</text>
            </view>
            <view class="cat-pick-name">{{item.name}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 手账标签多选 -->
    <view class="section-title reveal-3">手账标签</view>
    <view class="bezel-tray edit-bezel-tray reveal-3">
      <view class="bezel-core edit-bezel-core">
        <view class="tag-row">
          <view
            wx:for="{{tags}}"
            wx:key="id"
            class="tag tag-{{item.color}} tag-pick {{item._selected ? 'tag-pick-active' : ''}}"
            bindtap="onToggleTag"
            data-id="{{item.id}}"
          >
            <text wx:if="{{item._selected}}" class="tag-pick-check">✓</text>{{item.name}}
          </view>
          <view class="tag tag-add-btn" bindtap="onOpenAddTag">+ 新建标签</view>
        </view>
      </view>
    </view>

    <!-- 底部操作条 -->
    <view class="action-bar">
      <view class="btn btn-ghost flex-1" bindtap="onCancel">取消</view>
      <view class="btn btn-primary flex-1" bindtap="onSave">{{isEdit ? '保存修改' : '贴入日记'}}</view>
    </view>
  </block>
</view>

<!-- 新建标签弹窗 -->
<view wx:if="{{showAddTagModal}}" class="mask" catchtouchmove="" bindtap="onCloseAddTag">
  <view class="sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="sheet-title">新建手账标签</view>

    <view class="form-label">标签名称</view>
    <view class="input-wrap">
      <input
        class="input"
        placeholder="例如 出差、报销、纪念日、礼物"
        placeholder-class="input-placeholder"
        value="{{newTagName}}"
        bindinput="onNewTagNameInput"
        maxlength="8"
      />
    </view>

    <view class="form-label" style="margin-top: 20rpx;">标签色彩</view>
    <view class="color-row">
      <view
        wx:for="{{tagColorOptions}}"
        wx:key="*this"
        class="color-dot icon-circle-{{item}} {{newTagColor === item ? 'color-dot-active' : ''}}"
        catchtap="onPickNewTagColor"
        data-color="{{item}}"
      ></view>
    </view>

    <view class="sheet-actions">
      <view class="btn btn-ghost flex-1" catchtap="onCloseAddTag">取消</view>
      <view class="btn btn-primary flex-1" catchtap="onSaveNewTag">保存标签</view>
    </view>
  </view>
</view>

<!-- 更换小票图片手账抽屉 (Custom Handcrafted Image Sheet) -->
<view wx:if="{{showImageDrawer}}" class="mask" catchtouchmove="" bindtap="onCloseImageDrawer">
  <view class="custom-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="custom-sheet-header">
      <view class="sheet-title font-display" style="margin-bottom: 6rpx;">小票配图设置</view>
      <view class="sheet-item-sub">拍照拍摄、相册导入或使用手账矢量图标</view>
    </view>

    <view class="sheet-item-row" catchtap="onImageDrawerCamera">
      <view class="icon-circle icon-circle-green sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.camera}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">重新拍照</view>
        <view class="sheet-item-sub">打开相机拍摄最新纸质小票</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-item-row" catchtap="onImageDrawerAlbum">
      <view class="icon-circle icon-circle-orange sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.album}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">从相册选取新图</view>
        <view class="sheet-item-sub">选择手机相册中的小票或发票截图</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-item-row sheet-item-danger" catchtap="onImageDrawerRemove" wx:if="{{image}}">
      <view class="icon-circle icon-circle-pink sheet-item-ico">
        <image class="sheet-item-ico-img" src="{{icons.trash}}" mode="aspectFit" />
      </view>
      <view class="sheet-item-body">
        <view class="sheet-item-title">移除图片（使用手账图标）</view>
        <view class="sheet-item-sub">使用精美的手账分类图标作为小票头像</view>
      </view>
      <view class="sheet-item-arrow">›</view>
    </view>

    <view class="sheet-actions" style="margin-top: 24rpx;">
      <view class="btn btn-ghost btn-block" catchtap="onCloseImageDrawer">取消</view>
    </view>
  </view>
</view>
