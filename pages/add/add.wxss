@import "../../styles/tokens.wxss";

.add-page {
  padding-bottom: 220rpx;
}

/* 步骤 1：来源选择 */
.add-hero {
  text-align: center;
  padding: 30rpx 0 40rpx;
}

.add-hero-mascot {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--tm-primary-light) 0%, var(--tm-coffee-light) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  box-shadow: var(--tm-shadow-float);
}

.add-hero-img {
  width: 72rpx;
  height: 72rpx;
}

.add-hero-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
  letter-spacing: 0.03em;
}

.add-hero-sub {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

.pick-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 10rpx;
}

.pick-bezel-tray {
  cursor: pointer;
}

.pick-core {
  padding: 44rpx 20rpx 36rpx;
  text-align: center;
}

.pick-ico {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 18rpx;
}

.pick-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
}

.pick-sub {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

.pick-skip {
  text-align: center;
  margin-top: 50rpx;
  font-size: 26rpx;
  color: var(--tm-text-secondary);
  text-decoration: underline;
  padding: 16rpx;
  cursor: pointer;
}

/* 步骤 2：OCR 扫描动效 */
.scan-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 30rpx;
}

.scan-img-wrap {
  position: relative;
  width: 520rpx;
  height: 600rpx;
  background-color: var(--tm-bg-card);
  border-radius: var(--tm-radius-lg);
  border: 2rpx solid var(--tm-border);
  box-shadow: var(--tm-shadow-float);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
}

.scan-img {
  width: 100%;
  height: 100%;
}

.scan-placeholder-img {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.3;
}

/* 扫描激光线动画 */
.scan-laser {
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, transparent 0%, var(--tm-primary) 50%, transparent 100%);
  box-shadow: 0 0 16rpx var(--tm-primary);
  animation: scanLaser 2s infinite ease-in-out;
  z-index: 10;
}

.scan-status-tray {
  max-width: 580rpx;
  width: 100%;
}

.scan-status-core {
  text-align: center;
  padding: 28rpx 36rpx;
}

.scan-spin-box {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 16rpx;
}

.scan-spin-img {
  width: 80rpx;
  height: 80rpx;
  animation: rotate 3s infinite linear;
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.scan-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--tm-text-primary);
}

.scan-tip {
  font-size: 22rpx;
  color: var(--tm-text-muted);
  margin-top: 8rpx;
}

/* 步骤 3：编辑保存 */
.duplicate-banner {
  display: flex;
  align-items: flex-start;
  background: var(--tm-accent-light);
  border: 1rpx solid rgba(232, 168, 124, 0.4);
  padding: 16rpx 20rpx;
  border-radius: var(--tm-radius-sm);
  margin-bottom: 24rpx;
  box-shadow: var(--tm-shadow-sm);
}

.duplicate-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.duplicate-text {
  font-size: 24rpx;
  color: var(--tm-accent-deep);
  line-height: 1.4;
}

/* 预览图 */
.edit-preview {
  margin-bottom: 28rpx;
}

.edit-img-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: var(--tm-radius-md);
  overflow: hidden;
  box-shadow: var(--tm-shadow-card);
  border: 1rpx solid var(--tm-border);
}

.edit-img {
  width: 100%;
  height: 100%;
}

.edit-img-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 25, 20, 0.65);
  color: #FFFFFF;
  font-size: 22rpx;
  text-align: center;
  padding: 10rpx 0;
}

.edit-placeholder-tray {
  margin-bottom: 4rpx;
}

.edit-placeholder-core {
  padding: 24rpx;
  text-align: center;
}

.edit-placeholder-icon {
  width: 110rpx;
  height: 110rpx;
  margin: 0 auto 16rpx;
  box-shadow: var(--tm-shadow-sm);
}

.edit-ph-img {
  width: 68rpx;
  height: 68rpx;
}

.edit-placeholder-tip {
  font-size: 24rpx;
  color: var(--tm-text-muted);
  margin-bottom: 20rpx;
}

.edit-upload-btn {
  color: var(--tm-primary-deep);
  font-weight: 600;
  text-decoration: underline;
}

.edit-placeholder-options {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.placeholder-cell {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  transition: all 0.18s var(--tm-spring-bounce);
}

.placeholder-cell-active {
  border-color: var(--tm-primary);
  transform: scale(1.15);
  box-shadow: var(--tm-shadow-glow);
}

.ph-opt-img {
  width: 44rpx;
  height: 44rpx;
}

/* 表单卡片（Double-Bezel） */
.edit-bezel-tray {
  margin-bottom: 28rpx;
}

.edit-bezel-core {
  padding: 26rpx 22rpx;
}

.form-group {
  margin-bottom: 22rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--tm-text-primary);
  margin-bottom: 12rpx;
}

.amount-input-wrap {
  background: var(--tm-bg-inset);
}

.amount-prefix {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--tm-accent-deep);
  margin-right: 12rpx;
}

.amount-input {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--tm-text-primary);
}

.form-ico {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  opacity: 0.7;
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--tm-text-light);
  font-weight: bold;
}

/* 分类与标签列表 */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18rpx 8rpx;
}

.cat-pick {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 4rpx;
  border-radius: var(--tm-radius-sm);
  border: 2rpx solid transparent;
  transition: all 0.16s var(--tm-spring-ease);
}

.cat-pick-active {
  background-color: var(--tm-bg-inset);
  border-color: var(--tm-primary);
}

.cat-pick-img {
  width: 46rpx;
  height: 46rpx;
}

.cat-pick-emoji {
  font-size: 36rpx;
}

.cat-pick-name {
  font-size: 22rpx;
  color: var(--tm-text-primary);
  margin-top: 8rpx;
  font-weight: 600;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-pick {
  border: 1rpx solid transparent;
  cursor: pointer;
  transition: transform 0.18s var(--tm-spring-bounce);
}

.tag-pick-active {
  border-color: var(--tm-primary-deep);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  transform: scale(1.05);
}

.tag-add-btn {
  background: var(--tm-bg-card);
  border: 1rpx dashed var(--tm-border);
  color: var(--tm-primary-deep);
}

/* 底部操作条 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(24rpx + env(safe-area-inset-bottom, 24px));
  background: var(--tm-tab-bg);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
  border-top: 1rpx solid var(--tm-tab-border);
  display: flex;
  z-index: 100;
}
