<view class="tab-bar-outer">
  <view class="tab-bar">
    <view
      wx:for="{{list}}"
      wx:for-index="index"
      wx:key="pagePath"
      class="tab-bar-item {{item.isAction ? 'tab-bar-action' : ''}} {{selected == index ? 'tab-bar-item-active' : ''}}"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <view class="tab-icon-wrap {{item.isAction ? 'tab-action-wrap' : ''}}">
        <image class="{{item.isAction ? 'tab-action-img' : 'tab-icon-img'}}" src="{{item.iconSrc}}" mode="aspectFit" />
      </view>
      <text class="tab-text {{item.isAction ? 'tab-action-text' : ''}}">{{item.text}}</text>
    </view>
  </view>
  <view class="tab-bar-safe" style="height: {{safeBottom}}px;"></view>
</view>
